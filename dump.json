      if(d.prefs)prefs=d.prefs;if(d.attendance)attendance=d.attendance;n      if(prefs&&!prefs.courseSections)prefs.courseSections={};n      if(prefs&&!prefs.groups)prefs.groups=[];n      if(d.plannedLeave)plannedLeave=d.plannedLeave;if(d.friends)friends=d.friends;n      saveP();saveA();saveL();saveFriends();n      document.getElementById("top-badge").textContent="Sec "+prefs.section;n      closeS();renderHomeAll();alert("Backup restored ✓");n    }catch(err){alert("Invalid backup file");}n  };r.readAsText(f);n}nfunction resetAll(){if(confirm("Erase all data? Cannot be undone.")){localStorage.clear();location.hash="";location.reload();}}nnnnvar pendingQ=[],isRefreshing=false,lastAutoSync=0;nfunction loadQ(){try{pendingQ=JSON.parse(localStorage.getItem("t4_pending")||"[]");}catch(e){pendingQ=[];}}nfunction saveQ(){try{localStorage.setItem("t4_pending",JSON.stringify(pendingQ));}catch(e){}}nfunction enqueue(body){n  n  n  pendingQ=pendingQ.filter(function(b){n    if(body.action==="set"&&b.action==="set")return b.skey!==body.skey;n    if(body.action==="setPrefs"&&b.action==="setPrefs")return false;n    if(body.action==="setStatus"&&b.action==="setStatus")return false;n    if(body.action==="setFriends"&&b.action==="setFriends")return false;n    return true;n  });n  pendingQ.push(body);saveQ();updateSyncPill();n}nfunction postWrite(body){n  return fetch(EXEC_URL,{method:"POST",body:JSON.stringify(body),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){if(!d||!d.ok)throw new Error(d&&d.error||"server error");return true;});n}nfunction flushQueue(){n  if(!pendingQ.length||!prefs.rollNo)return Promise.resolve();n  var batch=pendingQ.slice();n  n  return batch.reduce(function(chain,body){n    return chain.then(function(){n      return postWrite(body).then(function(){n        pendingQ=pendingQ.filter(function(b){return b!==body;});saveQ();n      }).catch(function(){ throw "stop";});n    });n  },Promise.resolve()).catch(function(){}).then(function(){updateSyncPill();});n}nnfunction updateSyncPill(){n  var el=document.getElementById("synced");if(!el)return;n  var t=new Date().toLocaleTimeString("en-IN",{hour:"2-digit",minute:"2-digit"});n  var pend=pendingQ.length;n  var dot=pend?'<span class="dot" style="background:var(--warn)"></span>':'<span class="dot"></span>';n  var txt=pend?('saved locally · '+pend+' pending sync'):('live · synced '+t);n  el.innerHTML=dot+txt+'<button class="refresh-inline" onclick="refreshNow()">refresh</button>';n  var ss=document.getElementById("sb-sync");if(ss)ss.textContent=pend?(pend+" pending sync"):("synced "+t);n}nnfunction syncFetch(){n  var el=document.getElementById("synced");n  if(el)el.innerHTML='<span class="sync-indicator"></span>syncing...';n  return fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"get",rollNo:prefs.rollNo}),redirect:"follow"})n  .then(function(r){return r.json();})n  .then(function(d){n    if(d.ok&&d.data){n      n      var queuedKeys={};pendingQ.forEach(function(b){if(b.action==="set")queuedKeys[b.skey]=1;});n      Object.keys(d.data).forEach(function(k){if(queuedKeys[k])return;if(d.data[k])attendance[k]=d.data[k];else delete attendance[k];});n      n      Object.keys(attendance).forEach(function(k){if(!d.data[k]&&!queuedKeys[k])delete attendance[k];});n      saveA();n      var active=document.querySelector(".panel.on");n      if(active){var p=active.id.replace("p-","");if(p==="home")renderHomeAll();else if(p==="att")renderAtt();else if(p==="prog")renderProg();else if(p==="leave")renderLeave();}n    }n    updateSyncPill();n  }).catch(function(){n    if(el)el.innerHTML='<span class="dot" style="background:var(--warn)"></span>offline u2013 saved locally'+(pendingQ.length?' · '+pendingQ.length+' pending':'')+'<button class="refresh-inline" onclick="refreshNow()">retry</button>';n  });n}nnfunction refreshNow(){n  if(isRefreshing||!prefs.rollNo)return;n  isRefreshing=true;n  ["refresh-btn","refresh-btn-sb"].forEach(function(id){var b=document.getElementById(id);if(b)b.classList.add("spinning");});n  Promise.all([n    flushQueue().then(syncFetch),n    refreshFriends(),n    refreshGroups()n  ]).then(function(){n    lastAutoSync=Date.now();n  }).catch(function(){}).then(function(){n    isRefreshing=false;n    ["refresh-btn","refresh-btn-sb"].forEach(function(id){var b=document.getElementById(id);if(b)b.classList.remove("spinning");});n  });n}nnfunction syncMark(k,status,src){n  var body={action:"set",rollNo:prefs.rollNo,userSection:prefs.section,skey:k,status:status,src:src||"manual"};n  postWrite(body).then(function(){flushQueue();}).catch(function(){enqueue(body);});n}nfunction syncSavePrefs(){n  if(!prefs.rollNo)return;n  var body={action:"setPrefs",rollNo:prefs.rollNo,section:prefs.section,courses:prefs.courses,courseSections:prefs.courseSections||{},groups:prefs.groups||[]};n  postWrite(body).then(function(){flushQueue();}).catch(function(){enqueue(body);});n}nnnfunction syncFriendsList(){n  if(!prefs.rollNo)return;n  var activeFriends = Array.isArray(friends) ? friends.filter(Boolean) : [];n  var slim=activeFriends.map(function(f){return {id:f.id,name:f.name,rollNo:f.rollNo};});n  enqueue({action:"setFriends",rollNo:prefs.rollNo,friends:slim}); flushQueue();n}nfunction restoreFriendsList(){n  if(!prefs.rollNo)return Promise.resolve();n  return fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"getFriends",rollNo:prefs.rollNo}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      var addedRolls = [];n      if(d&&d.ok&&d.data&&d.data.length){n        var activeFriends = Array.isArray(friends) ? friends.filter(Boolean) : [];n        var seen={};activeFriends.forEach(function(f){if(f&&f.rollNo)seen[f.rollNo]=1;});n        d.data.forEach(function(cf){n          if(cf && cf.rollNo && !seen[cf.rollNo]){n            if(!Array.isArray(friends)) friends = [];n            friends.push({id:cf.id||Date.now().toString()+cf.rollNo,name:cf.name||cf.rollNo,rollNo:cf.rollNo,pending:true});n            seen[cf.rollNo]=1;n            addedRolls.push(cf.rollNo);n          }n        });n        if(addedRolls.length){n          saveFriends();n        }n      }n      if(addedRolls.length){n        return fetchFriendPrefs(addedRolls);n      }n    }).catch(function(){});n}nnnndocument.addEventListener("visibilitychange",function(){n  if(document.visibilityState==="visible"&&prefs.rollNo&&Date.now()-lastAutoSync>30000){n    lastAutoSync=Date.now();flushQueue().then(syncFetch);n  }n});nwindow.addEventListener("online",function(){if(prefs.rollNo)flushQueue().then(syncFetch);});nn nvar tlCode=null,tlDay=null;nfunction chrono(a,b){return a.date<b.date?-1:a.date>b.date?1:(a.sh*60+a.sm)-(b.sh*60+b.sm);} nfunction attBtnsHTML(k,st){n  return '<div class="att-actions"><button class="att-btn present '+(st==="present"?"on":"")+'" data-k="'+k+'" data-st="present">P</button>'n        +'<button class="att-btn absent '+(st==="absent"?"on":"")+'" data-k="'+k+'" data-st="absent">A</button></div>';n}nfunction showTimeline(code){n  tlCode=code;tlDay=null;n  var ss=mySessions().filter(function(s){return s.code===code;});n  var ex=(Array.isArray(EXAMS)?EXAMS:[]).filter(function(x){return x.code===code;});n  var all=ss.concat(ex).sort(chrono),ts=todayStr();n  document.getElementById("tl-title").textContent=code+" u2013 "+META[code].name;n  document.getElementById("tl-body").innerHTML=all.map(function(s){n    var isEx=!!s.type;n    var k=isEx?s.id:skey(s),st=attendance[k],isPast=s.date<=ts,d=new Date(s.date+"T00:00:00+05:30");n    var dl=d.getDate()+" "+MO[d.getMonth()]+" ("+DS[d.getDay()]+")";n    var dot=isPast?(st==="present"?"var(--okd)":st==="absent"?"var(--badd)":"var(--t3)"):"var(--s3)";n    if(isEx && st!=="present") dot = isPast ? "var(--t3)" : "var(--s3)";n    var right=isPast?attBtnsHTML(k,st):'<span class="tl-st upcoming">Upcoming</span>';n    var calBtn='<button class="sc-cal" style="margin-left:0;margin-right:6px" onclick="event.stopPropagation();'+(isEx?'addExamCal(''+k+'')':'addClassCal(''+k+'')')+'">＋</button>';n    var sn=isEx?(s.type==="AOL Exam"?"AOL":s.type):"S"+s.n;n    var snStyle=isEx?"width:auto;min-width:32px;color:var(--bad)":"";n    return '<div class="tl-row"><span class="tl-dot" style="background:'+dot+'"></span><span class="tl-sn" style="'+snStyle+'">'+sn+'</span><span class="tl-date">'+dl+'</span><span class="tl-slot">'+s.slot+'</span>'+calBtn+right+'</div>';n  }).join("");n  document.getElementById("tlsheet").classList.add("open");n}n nfunction showDay(ds){n  tlCode=null;tlDay=ds;n  var d=new Date(ds+"T00:00:00+05:30"),ss=byDate(ds),ts=todayStr();n  var ex=(Array.isArray(EXAMS)?EXAMS:[]).filter(function(x){n    return x.date===ds && (!x.code || prefs.courses.indexOf(x.code)>=0);n  });n  var all=ss.concat(ex).sort(chrono);n  document.getElementById("tl-title").textContent=DF[d.getDay()]+", "+d.getDate()+" "+MO[d.getMonth()];n  document.getElementById("tl-body").innerHTML=all.length?all.map(function(s){n    var isEx=!!s.type;n    var k=isEx?s.id:skey(s),st=attendance[k],isPast=s.date<=ts;n    var dot=isPast?(st==="present"?"var(--okd)":st==="absent"?"var(--badd)":"var(--t3)"):"var(--s3)";n    if(isEx && st!=="present") dot = isPast ? "var(--t3)" : "var(--s3)";n    var right=isPast?attBtnsHTML(k,st):'<span class="tl-st upcoming">Upcoming</span>';n    var calBtn='<button class="sc-cal" style="margin-left:0;margin-right:6px" onclick="event.stopPropagation();'+(isEx?'addExamCal(''+k+'')':'addClassCal(''+k+'')')+'">＋</button>';n    var sn=isEx?(s.code?s.code:s.type):s.code;n    var snStyle=isEx?"width:auto;min-width:32px;color:var(--bad)":"color:"+(CCOLOR[s.code]||"#888");n    var lbl=isEx?s.text:(META[s.code]?META[s.code].name:s.code);n    return '<div class="tl-row"><span class="tl-dot" style="background:'+dot+'"></span><span class="tl-sn" style="'+snStyle+'">'+sn+'</span><span class="tl-date">'+lbl+'</span><span class="tl-slot">'+s.slot+'</span>'+calBtn+right+'</div>';n  }).join(""):'<div class="free">No classes 🌿</div>';n  document.getElementById("tlsheet").classList.add("open");n}nfunction refreshOpenTL(){n  var tl=document.getElementById("tlsheet");n  if(!tl||!tl.classList.contains("open"))return;n  var tb=document.getElementById("tl-body"),sc=tb?tb.scrollTop:0;n  if(tlDay)showDay(tlDay);else if(tlCode)showTimeline(tlCode);n  var tb2=document.getElementById("tl-body");if(tb2)tb2.scrollTop=sc;n}nfunction closeTL(){document.getElementById("tlsheet").classList.remove("open");tlDay=null;tlCode=null;}nn ndocument.addEventListener("click",function(e){n  var t=e.target;n  if(t.closest && !t.closest(".sug-wrap")) {n    var boxes = document.querySelectorAll(".sug-box");n    for (var i = 0; i < boxes.length; i++) {n      if (boxes[i].style.display !== "none") {n        boxes[i].style.display = "none";n        boxes[i].innerHTML = "";n      }n    }n  }n  if(t.classList.contains("att-btn")&&t.dataset.k){mark(t.dataset.k,t.dataset.st);}n  else if(t.classList.contains("lp-chip")&&t.dataset.lk){togLeave(t.dataset.lk);}n  else if(t.classList.contains("lp-toggle")&&t.dataset.daytog){togDay(t.dataset.daytog);}n  else if(t.classList.contains("tl-btn")&&t.dataset.tl){showTimeline(t.dataset.tl);}n  else if(t.classList.contains("ann-x")&&t.dataset.ann){dismissAnn(t.dataset.ann);}n  else if(t.classList.contains("f-del")&&t.dataset.fid){deleteFriend(t.dataset.fid);}n  else if(t.dataset&&t.dataset.hmmode){setHmMode(t.dataset.hmmode);}n  else if(t.closest&&t.closest("[data-hmday]")){showDay(t.closest("[data-hmday]").dataset.hmday);}n  else if(t.dataset&&t.dataset.nudge){showDay(t.dataset.nudge);}n  else if(t.closest&&t.closest(".sug-item")){n    var it=t.closest(".sug-item"),box=it.parentNode,roll=it.dataset.roll,nm=it.dataset.name;n    if(box.id==="f-roll-sug"){document.getElementById("f-roll").value=roll;var nf=document.getElementById("f-name");if(nf&&!nf.value)nf.value=nm;onFriendRollInput();}n    else if(box.id==="f-search-sug"){document.getElementById("f-search").value=roll;searchRoll();}n    else if(box.id==="ob-restore-sug"){n      document.getElementById("ob-restore-roll").value=roll;n      box.style.display="none";box.innerHTML="";n      doRestore();n      return;n    }n    else if(box.id==="ob-roll-sug"){n      document.getElementById("ob-roll").value=roll;n      var sec=ROSTER[roll]?ROSTER[roll].s:"";n      if(sec){n        var btn=document.querySelector('#onboard .secbtn[data-s="'+sec+'"]');n        if(btn)obSec(btn);n      }n      obReady();n    }n    else if(box.id==="g-member-sug"){n      document.getElementById("g-member-roll").value=roll;n      onGroupMemberInput();n    }n    box.style.display="none";box.innerHTML="";n  }n  else if(t.closest&&t.closest("[data-gtog]")){n    var gc=t.closest("[data-gtog]").dataset.gtog,card=document.getElementById("gc-"+gc),body=document.getElementById("gbody-"+gc);n    if(body){var show=body.style.display==="none";body.style.display=show?"block":"none";if(card)card.classList.toggle("open",show);}n  }n  else{n    var ct=t.closest?t.closest(".ctog[data-ctog]"):null;if(ct){ct.classList.toggle("on");return;}n  }n});nn nvar plannerGroup = null;nvar plannerPrefs = {};nnfunction showGroupPlanner(code) {n  document.getElementById("onboard").style.display = "none";n  var shell = document.getElementById("shell");n  if(shell) shell.style.display = "none";n  n  var gp = document.getElementById("group-planner");n  if(gp) gp.style.display = "block";n  n  document.getElementById("gp-loading").style.display = "flex";n  document.getElementById("gp-content").style.display = "none";n  document.getElementById("gp-error").style.display = "none";n  n  fetchGroupPlannerData(code);n}nnfunction fetchGroupPlannerData(code) {n  var refreshBtn = document.getElementById("gp-refresh-btn");n  if(refreshBtn) refreshBtn.classList.add("spinning");n  n  fetch(EXEC_URL, {n    method: "POST",n    body: JSON.stringify({action: "getGroups", codes: [code]}),n    redirect: "follow"n  })n  .then(function(r) { return r.json(); })n  .then(function(d) {n    if(refreshBtn) refreshBtn.classList.remove("spinning");n    if(d && d.ok && d.data && d.data.groups && d.data.groups.length) {n      plannerGroup = d.data.groups[0];n      plannerPrefs = d.data.prefs || {};n      renderGroupPlanner();n    } else {n      showGroupPlannerError("Group not found or error loading group data.");n    }n  })n  .catch(function(err) {n    if(refreshBtn) refreshBtn.classList.remove("spinning");n    showGroupPlannerError("Failed to connect to the server: " + String(err));n  });n}nnfunction showGroupPlannerError(msg) {n  document.getElementById("gp-loading").style.display = "none";n  document.getElementById("gp-content").style.display = "block";n  var errBox = document.getElementById("gp-error");n  errBox.style.display = "block";n  errBox.textContent = msg;n}nnfunction refreshGroupPlanner() {n  if(plannerGroup && plannerGroup.code) {n    fetchGroupPlannerData(plannerGroup.code);n  } else if(INITIAL_GROUP) {n    fetchGroupPlannerData(INITIAL_GROUP);n  }n}nnfunction renderGroupPlanner() {n  document.getElementById("gp-loading").style.display = "none";n  document.getElementById("gp-content").style.display = "block";n  n  document.getElementById("gp-group-name").textContent = plannerGroup.name;n  var names = plannerGroup.members.map(function(m) {n    var roll = String(m).toUpperCase();n    return (ROSTER[roll] && ROSTER[roll].n) || roll;n  }).join(", ");n  document.getElementById("gp-group-meta").textContent = plannerGroup.members.length + " members: " + names + " · Code: " + plannerGroup.code;n  n  renderGroupHeatmap();n  renderGroupInsights();n  inspectGpDay(todayStr());n}nnfunction getGpMemberSessions(pref, ds) {n  if(!pref || !pref.section || !pref.courses) return [];n  return SESSIONS.filter(function(s){n    if(s.date !== ds) return false;n    if(pref.courses.indexOf(s.code) < 0) return false;n    if(s.section === "BOTH") return true;n    var want = (pref.courseSections && pref.courseSections[s.code]) || pref.section;n    return s.section === want;n  });n}nnfunction renderGroupHeatmap() {n  var ts = todayStr();n  var mos = [{y:2026,m:5,n:"Jun"}, {y:2026,m:6,n:"Jul"}, {y:2026,m:7,n:"Aug"}];n  n  var months = mos.map(function(mo) {n    var first = new Date(mo.y, mo.m, 1);n    var last = new Date(mo.y, mo.m + 1, 0);n    var dow = (first.getDay() + 6) % 7;n    var cells = "";n    n    for(var i=0; i<dow; i++) {n      cells += '<span class="hm-cell hm-empty"></span>';n    }n    n    for(var d=1; d<=last.getDate(); d++) {n      var date = mo.y + "-" + pad(mo.m + 1) + "-" + pad(d);n      var inTerm = date >= "2026-06-15" && date <= "2026-08-31";n      var dayOfWeek = new Date(date + "T00:00:00+05:30").getDay();n      n      var cls = "hm-off";n      var title = d + " " + MO[mo.m];n      n      if(inTerm) {n        var totalClasses = 0;n        plannerGroup.members.forEach(function(m) {n          var p = plannerPrefs[String(m).toUpperCase()];n          totalClasses += getGpMemberSessions(p, date).length;n        });n        var avgLoad = totalClasses / plannerGroup.members.length;n        n        if(totalClasses === 0) {n          cls = "gp-teal-free";n          title += " · 100% Free! 🌴";n        } else if(avgLoad <= 1.0) {n          cls = "gp-lime-low";n          title += " · Low load (avg " + avgLoad.toFixed(1) + ")";n        } else if(avgLoad <= 2.0) {n          cls = "gp-yellow-med";n          title += " · Medium load (avg " + avgLoad.toFixed(1) + ")";n        } else {n          cls = "gp-red-heavy";n          title += " · Heavy load (avg " + avgLoad.toFixed(1) + ")";n        }n      }n      n      var click = inTerm ? ' onclick="inspectGpDay('' + date + '')"' : '';n      var todayCls = date === ts ? " hm-today" : "";n      cells += '<span class="hm-cell ' + cls + todayCls + '" data-date="' + date + '"' + click + ' title="' + title + '" style="cursor:pointer;"></span>';n    }n    n    return '<div class="hm-month"><div class="hm-mlabel">' + mo.n + '</div>'n      + '<div class="hm-dow"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span></div>'n      + '<div class="hm-grid">' + cells + '</div></div>';n  }).join("");n  n  document.getElementById("gp-heatmap-months").innerHTML = months;n}nnfunction inspectGpDay(date) {n  var inspector = document.getElementById("gp-inspector-content");n  var dateTitle = document.getElementById("gp-inspector-date");n  if(!inspector) return;n  n  var d = new Date(date + "T00:00:00+05:30");n  if(isNaN(d.getTime())) {n    inspector.innerHTML = '<div class="free" style="padding:40px 10px;">Select a day on the heatmap to check availability.</div>';n    dateTitle.textContent = "Select a day";n    return;n  }n  n  dateTitle.textContent = DF[d.getDay()] + ", " + d.getDate() + " " + MO[d.getMonth()];n  n  var slotData = SLOTS.map(function(slot) {n    var time = slot[0];n    var sh = slot[1];n    var sm = slot[2];n    var busyUsers = [];n    var freeUsers = [];n    n    plannerGroup.members.forEach(function(m) {n      var roll = String(m).toUpperCase();n      var p = plannerPrefs[roll];n      var sessions = getGpMemberSessions(p, date);n      var isBusy = sessions.some(function(s) {n        return s.sh === sh && s.sm === sm;n      });n      n      var name = (ROSTER[roll] && ROSTER[roll].n) || roll;n      if(isBusy) {n        var sess = sessions.find(function(s) { return s.sh === sh && s.sm === sm; });n        busyUsers.push({roll: roll, name: name, code: sess.code});n      } else {n        freeUsers.push({roll: roll, name: name});n      }n    });n    n    return {n      time: time,n      busy: busyUsers,n      free: freeUsers,n      allFree: busyUsers.length === 0n    };n  });n  n  var commonFree = slotData.filter(function(s) { return s.allFree; }).map(function(s) { return s.time; });n  var commonFreeHTML = "";n  if(commonFree.length > 0) {n    commonFreeHTML = '<div style="background:rgba(46,196,182,0.12);border:.5px solid rgba(46,196,182,0.3);color:#2ec4b6;padding:10px 12px;border-radius:8px;font-size:11px;margin-bottom:16px;">'n      + '🌟 <b>Common Free Slots:</b> ' + commonFree.join(", ") + '</div>';n  } else {n    commonFreeHTML = '<div style="background:var(--s2);border:.5px solid var(--b2);color:var(--t2);padding:10px 12px;border-radius:8px;font-size:11px;margin-bottom:16px;">'n      + '⚠️ No slots today where <i>everyone</i> is free simultaneously.</div>';n  }n  n  var rowsHTML = slotData.map(function(s) {n    var isCommon = s.allFree ? ' <span style="font-size:8px;background:rgba(46,196,182,0.15);color:#2ec4b6;border-radius:12px;padding:1px 5px;margin-left:4px;">Free</span>' : '';n    n    var dots = plannerGroup.members.map(function(m) {n      var roll = String(m).toUpperCase();n      var b = s.busy.find(function(u) { return u.roll === roll; });n      var f = s.free.find(function(u) { return u.roll === roll; });n      n      if(b) {n        return '<span class="gp-user-dot busy" title="' + b.name + ' (' + b.roll + ') busy in ' + b.code + '">' + b.name.split(" ")[0] + ' (' + b.code + ')</span>';n      } else {n        return '<span class="gp-user-dot free" title="' + f.name + ' (' + f.roll + ') is free">' + f.name.split(" ")[0] + '</span>';n      }n    }).join("");n    n    return '<div class="gp-slot-row">'n      + '<div class="gp-slot-time"><b>' + s.time + '</b>' + isCommon + '</div>'n      + '<div class="gp-slot-status">' + dots + '</div>'n      + '</div>';n  }).join("");n  n  inspector.innerHTML = commonFreeHTML + '<div style="display:flex;flex-direction:column;gap:4px;">' + rowsHTML + '</div>';n  n  document.querySelectorAll("#gp-heatmap-months .hm-cell").forEach(function(cell) {n    cell.style.outline = "none";n    cell.style.outlineOffset = "0px";n  });n  var selectedCell = document.getElementById("gp-heatmap-months").querySelector('.hm-cell[onclick*="' + date + '"]');n  if(selectedCell) {n    selectedCell.style.outline = "2px solid var(--acc)";n    selectedCell.style.outlineOffset = "1px";n  }n}nnvar gpTripLen = 3;nnfunction changeGpTripLen(k) {n  gpTripLen = k;n  document.querySelectorAll(".dur-btn").forEach(function(btn) {n    btn.classList.toggle("active", parseInt(btn.dataset.len, 10) === k);n  });n  renderGroupInsights();n}nnfunction highlightGpHeatmapRange(startDate, endDate) {n  document.querySelectorAll("#gp-heatmap-months .hm-cell").forEach(function(cell) {n    cell.style.outline = "none";n    cell.style.outlineOffset = "0px";n    cell.style.boxShadow = "none";n  });n  document.querySelectorAll("#gp-heatmap-months .hm-cell").forEach(function(cell) {n    var d = cell.dataset.date;n    if (d && d >= startDate && d <= endDate) {n      cell.style.outline = "2px solid var(--acc)";n      cell.style.outlineOffset = "1px";n      cell.style.boxShadow = "0 0 8px var(--acc)";n    }n  });n}nnfunction toggleGpInsightDetail(card, startDate, endDate) {n  var detail = card.querySelector(".gp-insight-detail");n  if (detail) {n    var show = detail.style.display === "none";n    detail.style.display = show ? "block" : "none";n  }n  highlightGpHeatmapRange(startDate, endDate);n}nnfunction stdDev(arr) {n  var n = arr.length;n  if (n <= 1) return 0;n  var mean = arr.reduce(function(a, b) { return a + b; }, 0) / n;n  var variance = arr.reduce(function(a, b) { return a + Math.pow(b - mean, 2); }, 0) / n;n  return Math.sqrt(variance);n}nnfunction getVulnerability(buffer) {n  if (buffer <= 0) return 1000;n  if (buffer === 1) return 10;n  if (buffer === 2) return 3;n  return 1;n}nnfunction renderGroupInsights() {n  var insightsEl = document.getElementById("gp-insights");n  if(!insightsEl) return;n  n  var start = new Date("2026-06-15T00:00:00+05:30");n  var end = new Date("2026-08-31T00:00:00+05:30");n  var days = [];n  n  for(var d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {n    var dateStr = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());n    n    var totalClasses = 0;n    plannerGroup.members.forEach(function(m) {n      var p = plannerPrefs[String(m).toUpperCase()];n      totalClasses += getGpMemberSessions(p, dateStr).length;n    });n    n    days.push({n      date: dateStr,n      totalClasses: totalClasses,n      dateObj: new Date(d)n    });n  }n  n  var k = gpTripLen;n  var candidates = [];n  n  for (var i = 0; i <= days.length - k; i++) {n    var windowDays = days.slice(i, i + k);n    var hasIllegalMember = false;n    var totalClassesMissed = 0;n    var individualPenalties = [];n    n    plannerGroup.members.forEach(function(m) {n      var roll = String(m).toUpperCase();n      var p = plannerPrefs[roll];n      if (!p) {n        individualPenalties.push(0);n        return;n      }n      n      var missedCount = {};n      windowDays.forEach(function(wd) {n        var daySessions = getGpMemberSessions(p, wd.date);n        daySessions.forEach(function(s) {n          missedCount[s.code] = (missedCount[s.code] || 0) + 1;n          totalClassesMissed++;n        });n      });n      n      var p_u = 0;n      p.courses.forEach(function(c) {n        var missed = missedCount[c] || 0;n        if (missed > 0) {n          var initialAbsent = (roll === prefs.rollNo) ? attStats(c).absent : 0;n          var finalBuffer = 4 - (initialAbsent + missed);n          if (finalBuffer < 0) hasIllegalMember = true;n          p_u += missed * getVulnerability(finalBuffer);n        }n      });n      n      individualPenalties.push(p_u);n    });n    n    var maxPenalty = Math.max.apply(null, individualPenalties);n    var std = stdDev(individualPenalties);n    var jointPenalty = maxPenalty + 0.5 * std;n    n    var freeDays = windowDays.filter(function(wd) { return wd.totalClasses === 0; }).length;n    var LR = freeDays / k;n    n    var score = jointPenalty - 2.0 * LR;n    if (hasIllegalMember) score = 9999;n    n    candidates.push({n      windowDays: windowDays,n      score: score,n      totalClassesMissed: totalClassesMissed,n      LR: LR,n      hasIllegalMember: hasIllegalMember,n      individualPenalties: individualPenaltiesn    });n  }n  n  candidates.sort(function(a, b) {n    return a.score - b.score;n  });n  n  var topCandidates = candidates.filter(function(c) { return !c.hasIllegalMember; }).slice(0, 4);n  if (topCandidates.length === 0) {n    insightsEl.innerHTML = '<div style="color:var(--t3);padding:10px 0;">No feasible trip options found for ' + k + ' days (all options cause attendance limits to be breached for some members).</div>';n    return;n  }n  n  insightsEl.innerHTML = topCandidates.map(function(c) {n    var stretch = c.windowDays;n    var sDate = stretch[0].dateObj;n    var eDate = stretch[stretch.length - 1].dateObj;n    var dateRangeStr = sDate.getDate() + " " + MO[sDate.getMonth()] + " u2013 " + eDate.getDate() + " " + MO[eDate.getMonth()];n    var avgLoad = c.totalClassesMissed / plannerGroup.members.length;n    n    var badgeText = "";n    var badgeStyle = "";n    if (c.score <= 0) {n      badgeText = "🌴 Perfect";n      badgeStyle = "background:rgba(46,196,182,0.15);color:#2ec4b6;";n    } else if (c.score < 3) {n      badgeText = "Feasible";n      badgeStyle = "background:rgba(212,242,68,0.15);color:#b3d600;";n    } else {n      badgeText = "Caution";n      badgeStyle = "background:rgba(240,184,74,0.15);color:var(--warn);";n    }n    n    var memberDetailsHTML = plannerGroup.members.map(function(m) {n      var roll = String(m).toUpperCase();n      var p = plannerPrefs[roll];n      var name = ROSTER[roll] ? ROSTER[roll].n : roll;n      if (!p) return '<div>👤 <b>' + name + '</b>: No setup loaded</div>';n      n      var missedClasses = {};n      var totalMissed = 0;n      stretch.forEach(function(wd) {n        getGpMemberSessions(p, wd.date).forEach(function(s) {n          missedClasses[s.code] = (missedClasses[s.code] || 0) + 1;n          totalMissed++;n        });n      });n      n      var coursesText = [];n      for (var code in missedClasses) {n        var missed = missedClasses[code];n        var initialAbsent = (roll === prefs.rollNo) ? attStats(code).absent : 0;n        var finalBuffer = 4 - (initialAbsent + missed);n        var bufferClass = finalBuffer <= 1 ? 'color:var(--bad);font-weight:bold;' : (finalBuffer === 2 ? 'color:var(--warn);' : 'color:var(--ok);');n        coursesText.push(code + ': <b>' + missed + '</b> missed (<span style="' + bufferClass + '">' + finalBuffer + ' buffer left</span>)');n      }n      n      var detailStr = totalMissed === 0 n        ? '<span style="color:var(--ok);">0 classes missed</span>' n        : coursesText.join(", ");n        n      return '<div style="margin-bottom:4px;font-size:10px;color:var(--t2);">'n        + '👤 <b>' + name + '</b>: ' + detailStrn        + '</div>';n    }).join("");n    n    return '<div class="gp-insight-card" onclick="toggleGpInsightDetail(this, '' + stretch[0].date + '', '' + stretch[stretch.length - 1].date + '')">'n      + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">'n      + '<b style="color:var(--ok);">' + dateRangeStr + '</b>'n      + '<span style="font-size:10px;border-radius:12px;padding:2px 8px;font-weight:600;' + badgeStyle + '">' + badgeText + '</span>'n      + '</div>'n      + '<div style="display:flex;gap:6px;margin:6px 0;flex-wrap:wrap;">'n      + '<span style="font-size:9px;background:rgba(46,196,182,0.1);color:#2ec4b6;padding:2px 6px;border-radius:4px;">' + (c.LR * 100).toFixed(0) + '% Free Days</span>'n      + '<span style="font-size:9px;background:rgba(255,255,255,0.05);color:var(--t2);padding:2px 6px;border-radius:4px;">Avg ' + avgLoad.toFixed(1) + ' missed classes</span>'n      + '</div>'n      + '<div class="gp-insight-detail" style="display:none;margin-top:10px;padding-top:10px;border-top:.5px solid var(--b1);">'n      + memberDetailsHTMLn      + '</div>'n      + '</div>';n  }).join("");n}nfunction showInfoModal(type, ev) {n  if (ev) ev.stopPropagation();n  var title = "";n  var body = "";n  if (type === 'bunk') {n    title = "ℹ️ Bunk-o-Meter Guide";n    body = "<p>The <b>Bunk-o-Meter</b> calculates your remaining safety cushion before you exceed the attendance limit (maximum of 4 allowed absences per course).</p>"n      + "<p style='margin-top:8px;'>u2022 <b>Skips Left</b>: Displays the lowest cushion among all your enrolled courses.</p>"n      + "<p style='margin-top:8px;'>u2022 <b>Slider Color</b>:"n      + "<br>&nbsp;&nbsp;- <span style='color:var(--ok);font-weight:bold;'>Green (Safe)</span>: 2 or more skips remaining in all courses."n      + "<br>&nbsp;&nbsp;- <span style='color:var(--warn);font-weight:bold;'>Orange (Warning)</span>: Exactly 1 skip remaining in at least one course."n      + "<br>&nbsp;&nbsp;- <span style='color:var(--bad);font-weight:bold;'>Red (Danger)</span>: 0 skips remaining (limit reached) or exceeded.</p>";n  } else if (type === 'trip') {n    title = "ℹ️ Smart Trip Planner Guide";n    body = "<p>The <b>Group Trip Planner</b> finds the best travel windows of your selected length (3, 4, 5, or 9 days) by analyzing group class load and leveraging weekends/holidays.</p>"n      + "<p style='margin-top:8px;'><b>Explainable Score Badges</b>:</p>"n      + "<p style='margin-top:4px;'>u2022 <span style='color:var(--ok);font-weight:bold;'>🌴 Perfect</span>: Nobody in the group misses a single class.</p>"n      + "<p style='margin-top:4px;'>u2022 <span style='color:#b3d600;font-weight:bold;'>Feasible</span>: Members miss classes, but everyone's attendance buffer remains safe (2+ skips left).</p>"n      + "<p style='margin-top:4px;'>u2022 <span style='color:var(--warn);font-weight:bold;'>Caution</span>: Safe to travel, but eats up buffer (leaves someone with only 1 skip left).</p>"n      + "<p style='margin-top:8px;'><b>Automatic Pruning</b>: Any trip that would cause even <i>one</i> member to drop below 0 skips (violating the attendance limit) is automatically filtered out as Critical/Illegal.</p>"n      + "<p style='margin-top:8px;'><i>Tip: Click on a trip card to view exact classes missed and buffers for each member, and highlight the range on the heatmap.</i></p>";n  }n  document.getElementById("info-modal-title").textContent = title;n  document.getElementById("info-modal-body").innerHTML = body;n  var m = document.getElementById("info-modal");n  if(m) m.classList.add("open");n}nfunction closeInfoModal() {n  var m = document.getElementById("info-modal");n  if(m) m.classList.remove("open");n}nn nfunction showInstallModal(){n  var im = document.getElementById("imov");n  if(im) im.classList.add("open");n}nfunction closeInstallModal(){n  var im = document.getElementById("imov");n  if(im) im.classList.remove("open");n}nfunction dismissInstallHint(){n  var hint = document.getElementById("gp-install-hint");n  if(hint) hint.style.display = "none";n  try{ localStorage.setItem("t4_install_dismissed", "1"); }catch(e){}n}nfunction setInstTab(platform){n  var tabs = ["safari", "chrome"];n  tabs.forEach(function(p){n    var tab = document.getElementById("itab-" + p);n    var content = document.getElementById("inst-content-" + p);n    if(p === platform){n      if(tab) tab.classList.add("on");n      if(content) content.style.display = "block";n    } else {n      if(tab) tab.classList.remove("on");n      if(content) content.style.display = "none";n    }n  });n}nvar activeOnboardInput = null;nnfunction trackOnboardFocus(input) {n  activeOnboardInput = input;n  document.getElementById("ob-numpad").style.display = "block";n}nnfunction handleNumpadPress(val) {n  if (!activeOnboardInput) return;n  var input = activeOnboardInput;n  var startVal = input.value;n  n  if (val === 'back') {n    input.value = startVal.slice(0, -1);n  } else if (val === 'B25') {n    if (!input.value.startsWith('B')) {n      input.value = 'B25' + input.value;n    }n  } else {n    input.value = startVal + val;n  }n  n  var current = input.value.trim();n  if (/^d/.test(current)) {n    if (current.length <= 3) {n      input.value = 'B25' + current;n    } else if (current.length === 5) {n      input.value = 'B' + current;n    }n  }n  n  if (input.id === "ob-resto