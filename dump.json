=hmStreak(),mk=T.present+T.absent,pct=mk?Math.round(T.present/mk*100):0;n  var toggle='<div class="hm-toggle"><button class="hm-tb'+(att?" on":"")+'" data-hmmode="att">Attendance</button><button class="hm-tb'+(att?"":" on")+'" data-hmmode="load">Load</button></div>';n  var stats='<div class="hm-stats">'n    +'<div class="hm-stat"><div class="hm-sv" style="color:var(--acc)">'+streak+'</div><div class="hm-sl">🔥 streak</div></div>'n    +'<div class="hm-stat"><div class="hm-sv" style="color:var(--ok)">'+T.present+'</div><div class="hm-sl">present</div></div>'n    +'<div class="hm-stat"><div class="hm-sv" style="color:var(--bad)">'+T.absent+'</div><div class="hm-sl">absent</div></div>'n    +'<div class="hm-stat"><div class="hm-sv" style="color:var(--warn)">'+T.unmarked+'</div><div class="hm-sl">unmarked</div></div>'n    +'<div class="hm-stat"><div class="hm-sv">'+pct+'%</div><div class="hm-sl">present rate</div></div>'n    +'</div>';n  var months=mos.map(function(mo){n    var first=new Date(mo.y,mo.m,1),last=new Date(mo.y,mo.m+1,0),dow=(first.getDay()+6)%7,cells="";n    for(var i=0;i<dow;i++)cells+='<span class="hm-cell hm-empty"></span>';n    for(var d=1;d<=last.getDate();d++){n      var date=mo.y+"-"+pad(mo.m+1)+"-"+pad(d),inTerm=date>="2026-06-15"&&date<="2026-08-31";n      var cls,title,cnt=cntMap[date]||0,early=!!earlyMap[date],hasEx=!!examMap[date];n      if(!inTerm){cls="hm-off";title=d+" "+MO[mo.m];}n      else if(att){n        var ag=dayAgg(date);n        if(ag.total===0){cls="hm-off";title=d+" "+MO[mo.m]+" · no class";}n        else if(date>ts){cls="hm-future";title=d+" "+MO[mo.m]+" · "+ag.total+" upcoming";}n        else if(ag.absent>0){cls="hm-bad";title=d+" "+MO[mo.m]+" · "+ag.absent+" absent of "+ag.total;}n        else if(ag.unmarked===0){cls="hm-good";title=d+" "+MO[mo.m]+" · all "+ag.total+" present";}n        else if(ag.present>0){cls="hm-part";title=d+" "+MO[mo.m]+" · "+ag.present+"/"+ag.total+" marked";}n        else {cls="hm-miss";title=d+" "+MO[mo.m]+" · "+ag.total+" unmarked";}n      } else {n        cls=cnt===0?"hm-off":cnt===1?"hm-l1":cnt===2?"hm-l2":cnt===3?"hm-l3":"hm-l4";n        title=d+" "+MO[mo.m]+" · "+cnt+" sessions";n      }n      var click=((cnt>0||hasEx)&&inTerm)?' data-hmday="'+date+'"':'';   n      cells+='<span class="hm-cell '+cls+(date===ts?" hm-today":"")+(early?" hm-early":"")+(hasEx?" hm-exam":"")+'"'+click+' title="'+title+(hasEx?" · 📝 Assessment":"")+(early?" · ⏰ early class":"")+'"></span>';n    }n    return '<div class="hm-month"><div class="hm-mlabel">'+mo.n+'</div>'n      +'<div class="hm-dow"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span></div>'n      +'<div class="hm-grid">'+cells+'</div></div>';n  }).join("");n  var legend=attn    ?'<span class="hm-cell hm-good"></span>all present <span class="hm-cell hm-part"></span>partial <span class="hm-cell hm-miss"></span>unmarked <span class="hm-cell hm-bad"></span>absent <span class="hm-cell hm-future"></span>upcoming'n    :'<span class="hm-cell hm-off"></span>0 <span class="hm-cell hm-l1"></span>1 <span class="hm-cell hm-l2"></span>2 <span class="hm-cell hm-l3"></span>3 <span class="hm-cell hm-l4"></span>4+ <span class="hm-cell hm-early" style="background:var(--s2)"></span>⏰ early <span class="hm-cell hm-exam" style="background:var(--s2)"></span>📝 exam';n  return '<div class="heatmap-wrap"><div class="hm-top"><div class="hm-head">Term heatmap</div>'+toggle+'</div>'n    +stats+'<div class="hm-hint">Tap any day to see its classes · past days are markable.</div>'n    +'<div class="hm-months">'+months+'</div>'n    +'<div class="hm-legend">'+legend+'</div></div>';n}nn nfunction svgRing(present,total,color){n  var sz=44,cx=22,cy=22,r=17,circ=2*Math.PI*r,pct=total?present/total:0;n  var dash=(circ*pct).toFixed(1),gap=(circ*(1-pct)).toFixed(1);n  return '<svg width="'+sz+'" height="'+sz+'" viewBox="0 0 '+sz+' '+sz+'" style="flex-shrink:0">'n    +'<circle cx="'+cx+'" cy="'+cy+'" r="'+r+'" fill="none" stroke="var(--s3)" stroke-width="3.5"/>'n    +'<circle cx="'+cx+'" cy="'+cy+'" r="'+r+'" fill="none" stroke="'+color+'" stroke-width="3.5"'n    +' stroke-dasharray="'+dash+' '+gap+'" stroke-linecap="round" transform="rotate(-90 '+cx+' '+cy+')"'n    +' style="transition:stroke-dasharray .6s"/>'n    +'<text x="'+cx+'" y="'+(cy+4)+'" text-anchor="middle" fill="'+color+'" font-size="9" font-family="Syne,sans-serif" font-weight="700">'+Math.round(pct*100)+'%</text>'n    +'</svg>';n}nfunction svgRingLarge(present,total,color){n  var sz=52,cx=26,cy=26,r=20,circ=2*Math.PI*r,pct=total?present/total:0;n  var dash=(circ*pct).toFixed(1),gap=(circ*(1-pct)).toFixed(1);n  return '<svg width="'+sz+'" height="'+sz+'" viewBox="0 0 '+sz+' '+sz+'" style="flex-shrink:0">'n    +'<circle cx="'+cx+'" cy="'+cy+'" r="'+r+'" fill="none" stroke="var(--s3)" stroke-width="4"/>'n    +'<circle cx="'+cx+'" cy="'+cy+'" r="'+r+'" fill="none" stroke="'+color+'" stroke-width="4"'n    +' stroke-dasharray="'+dash+' '+gap+'" stroke-linecap="round" transform="rotate(-90 '+cx+' '+cy+')"'n    +' style="transition:stroke-dasharray .6s"/>'n    +'<text x="'+cx+'" y="'+(cy+4)+'" text-anchor="middle" fill="'+color+'" font-size="11" font-family="Syne,sans-serif" font-weight="700">'+Math.round(pct*100)+'%</text>'n    +'</svg>';n}nn nfunction scard(s,withAtt){n  var k=skey(s),late=s.late?'<span class="late">late</span>':'',att='';n  if(withAtt){var st=attendance[k];att='<div class="att-actions"><button class="att-btn present '+(st==='present'?"on":"")+'" data-k="'+k+'" data-st="present">P</button><button class="att-btn absent '+(st==='absent'?"on":"")+'" data-k="'+k+'" data-st="absent">A</button></div>';}n  var cc=META[s.code];if(!cc)return'';n  var venue=s.venue?'<span class="sc-venue">'+s.venue+'</span>':"";n  var calBtn=withAtt?'<button class="sc-cal" onclick="event.stopPropagation();addClassCal(''+k+'')" title="Add to calendar">＋</button>':"";n  return '<div class="scard" style="--cc:'+(CCOLOR[s.code]||"#888")+'"><div class="scard-tint"></div><span class="sc-code">'+s.code+'</span><span class="sc-name">'+cc.name+'</span><span class="sc-meta">S'+s.n+' · '+s.slot+late+venue+'</span>'+att+calBtn+'</div>';n}nfunction renderDay(ms,label,withAtt){n  var d=new Date(ms),ds=dstr(d),ss=byDate(ds);n  var h='<div class="daylabel">'+label+' · '+DF[d.getDay()]+', '+d.getDate()+' '+MO[d.getMonth()]+'</div>';n  return h+(ss.length?ss.map(function(s){return scard(s,withAtt);}).join(""):'<div class="free">No classes 🌿🤙</div>');n}nn nfunction renderHomeAll(){renderMyStatus();renderIosPin();renderAnnouncements();renderChanges();renderEarlyWarning();renderWeekHeat();renderTodayStrip();renderHome();renderExams();}nnnfunction renderEarlyWarning(){n  var el=document.getElementById("h-early");if(!el)return;n  var em=earlyDatesMap_();n  var tm=todayMs(),t1=dstr(new Date(tm+864e5)),t2=dstr(new Date(tm+2*864e5));n  var when=em[t1]?"tomorrow":em[t2]?"in 2 days":null;n  if(!when){el.innerHTML="";return;}n  el.innerHTML='<div class="nudge"><span class="nudge-ico">⏰</span>'n    +'<div class="nudge-body"><div class="nudge-t">Early start '+when+'</div>'n    +'<div class="nudge-s">8:00 AM class or quiz u2014 plan your night accordingly.</div></div></div>';n}nnnfunction examBadgeClass_(type){n  return {"Quiz":"quiz","Mid-Term":"mid","End-Term":"end","AOL Exam":"aol","Notice":"notice"}[type]||"end";n}nfunction examRowHTML(x){n  var d=new Date(x.date+"T00:00:00+05:30"),tm=todayMs(),days=Math.round((d.getTime()-tm)/864e5);n  var cd,cdCls="";n  if(days<0){cd="<b>Past</b>";cdCls="";}n  else if(days===0){cd="<b>Today</b>";cdCls="imminent";}n  else if(days===1){cd="<b>1</b>day";cdCls="imminent";}n  else if(days<=3){cd="<b>"+days+"</b>days";cdCls="soon";}n  else{cd="<b>"+days+"</b>days";}n  var when=DF[d.getDay()]+", "+d.getDate()+" "+MO[d.getMonth()]+" · "+x.slot;n  var courseName=x.code&&META[x.code]?META[x.code].name+" u2014 ":"";n  var venue=x.venue?'<span class="exam-venue">'+x.venue+'</span>':"";n  var isNotice=x.type==="Notice";n  var attended=attendance[x.id]==="present";n  var attendBtn=isNotice?"":'<button class="exam-attend'+(attended?" on":"")+'" onclick="toggleExamAttend(''+x.id+'')">'+(attended?"✓ Attended":"Mark attended")+'</button>';n  return '<div class="exam-row">'n    +'<span class="exam-badge '+examBadgeClass_(x.type)+'">'+x.type+'</span>'n    +'<div class="exam-body"><div class="exam-text">'+courseName+x.text+'</div><div class="exam-when">'+when+venue+'</div>'+attendBtn+'</div>'n    +'<div class="exam-cd '+cdCls+'">'+cd+'</div>'n    +(isNotice?'':'<button class="exam-cal" onclick="addExamCal(''+x.id+'')" title="Add to calendar">＋ Cal</button>')+'</div>';n}nfunction renderExams(){n  var el=document.getElementById("h-exams");if(!el)return;n  var full=document.getElementById("ex-full-list");n  if(!Array.isArray(EXAMS)||!EXAMS.length){el.innerHTML="";if(full)full.innerHTML='<div class="free">No assessments scheduled 🌿</div>';return;}n  var ts=todayStr();n  var rel=EXAMS.filter(function(x){return !x.code || prefs.courses.indexOf(x.code)>=0;});n  var up=rel.filter(function(x){return x.date>=ts;}).sort(function(a,b){n    return a.date<b.date?-1:a.date>b.date?1:(a.sh*60+a.sm)-(b.sh*60+b.sm);n  });n  var past=rel.filter(function(x){return x.date<ts;}).sort(function(a,b){n    return a.date>b.date?-1:a.date<b.date?1:(b.sh*60+b.sm)-(a.sh*60+a.sm); n  });n  examUpcoming=up;n  if(!up.length && !past.length){el.innerHTML="";if(full)full.innerHTML='<div class="free">No assessments scheduled 🌿</div>';return;}n  n  if(up.length) {n    var previewCount=Math.min(up.length,3);n    var rows=up.slice(0,previewCount).map(examRowHTML).join("");n    var seeAll=(up.length>previewCount || past.length)?'<a class="exam-see-all" onclick="openExams()">See all '+(up.length+past.length)+' →</a>':'';n    el.innerHTML='<div class="exam-wrap"><div class="exam-head"><span class="exam-title">📌 Upcoming Assessments</span>'n      +'<span class="exam-count">'+up.length+' scheduled</span></div>'n      +rows+seeAll+'</div>';n  } else {n    el.innerHTML='<div class="exam-wrap"><div class="exam-head"><span class="exam-title">📌 Assessments</span></div><a class="exam-see-all" onclick="openExams()">See past assessments →</a></div>';n  }n  if(full){n    var upHtml = up.length ? up.map(examRowHTML).join("") + '<button class="exam-allcal" onclick="addAllExamsCal()">＋ Add all '+up.length+' to calendar</button>' : '<div class="free">No upcoming assessments</div>';n    var pastHtml = past.length ? '<div class="exam-head" style="margin-top:24px"><span class="exam-title">⏳ Past Assessments</span></div>' + past.map(examRowHTML).join("") : '';n    full.innerHTML = upHtml + pastHtml + '<div class="exam-note">Filtered to your enrolled courses, plus anything not tied to one course (AOL, registration notices).</div>';n  }n}nvar examUpcoming=[];nfunction openExams(){ renderExams(); var ov=document.getElementById("exov"); if(ov)ov.classList.add("open"); }nfunction closeExams(){ var ov=document.getElementById("exov"); if(ov)ov.classList.remove("open"); }nfunction toggleExamAttend(id){n  var x=EXAMS.find(function(e){return e.id===id;}); if(!x||x.type==="Notice")return;n  var ns=attendance[id]==="present"?"":"present";n  if(!ns)delete attendance[id];else attendance[id]=ns;n  try{if(navigator.vibrate)navigator.vibrate(9);}catch(e){}n  saveA();n  renderExams();n  if(prefs.rollNo)syncMark(id,ns||null,"exam");n  showToast(ns?"Marked attended":"Unmarked");n}nn nfunction icsEsc(s){return String(s).replace(//g,"").replace(/;/g,";").replace(/,/g,",").replace(/n/g,"n");}nfunction deEnt(s){return String(s).replace(/&amp;/g,"&").replace(/&lt;/g,"<").replace(/&gt;/g,">");}nfunction icsLocal(date,sh,sm,addMin){n  var dt=new Date(date+"T00:00:00+05:30");dt.setHours(sh,sm+(addMin||0),0,0);n  return dt.getFullYear()+pad(dt.getMonth()+1)+pad(dt.getDate())+"T"+pad(dt.getHours())+pad(dt.getMinutes())+"00";n}nfunction buildICS(events){n  var L=["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//Term IV Command Centre//EN","CALSCALE:GREGORIAN"];n  events.forEach(function(ev){n    L.push("BEGIN:VEVENT");n    L.push("UID:"+ev.uid);n    L.push("DTSTAMP:"+icsLocal(todayStr(),0,0,0));n    L.push("DTSTART:"+ev.start);n    L.push("DTEND:"+ev.end);n    L.push("SUMMARY:"+icsEsc(ev.summary));n    if(ev.desc)L.push("DESCRIPTION:"+icsEsc(ev.desc));n    (ev.alarms||[]).forEach(function(tr){L.push("BEGIN:VALARM","ACTION:DISPLAY","DESCRIPTION:"+icsEsc(ev.summary),"TRIGGER:"+tr,"END:VALARM");});n    L.push("END:VEVENT");n  });n  L.push("END:VCALENDAR");n  return L.join("rn");n}nfunction downloadICS(fname,events){n  if(!events.length){showToast("Nothing to add");return;}n  var b=new Blob([buildICS(events)],{type:"text/calendar;charset=utf-8"});n  var a=document.createElement("a");a.href=URL.createObjectURL(b);a.download=fname;document.body.appendChild(a);a.click();a.remove();n  showToast(events.length+" added u2014 open the file to save to your calendar");n}nfunction examEvent(x){n  var title=deEnt(x.text);n  return {uid:(x.date+"-"+x.sh+x.sm+"-"+x.type).replace(/[^A-Za-z0-9-]/g,"")+"@term4",n    start:icsLocal(x.date,x.sh,x.sm,0),end:icsLocal(x.date,x.sh,x.sm,90),n    summary:"["+x.type+"] "+title,desc:"Assessment from the Term IV timetable",n    alarms:["-P1D","-PT1H"]};n}nfunction addExamCal(id){var x=EXAMS.find(function(e){return e.id===id;});if(!x)return;downloadICS("assessment.ics",[examEvent(x)]);}nfunction addAllExamsCal(){downloadICS("term4-assessments.ics",examUpcoming.map(examEvent));}nfunction exportTimetableICS(){n  var ts=todayStr();n  var ev=mySessions().filter(function(s){return s.date>=ts;}).map(function(s){n    return {uid:(s.date+"-"+s.sh+s.sm+"-"+s.code).replace(/[^A-Za-z0-9-]/g,"")+"@term4",n      start:icsLocal(s.date,s.sh,s.sm,0),end:icsLocal(s.date,s.sh,s.sm,90),n      summary:s.code+" · "+META[s.code].name,desc:"S"+s.n+" · "+s.slot,alarms:["-PT30M"]};n  });n  downloadICS("term4-timetable.ics",ev);n}nnnfunction classEvent(s){n  return {uid:(s.date+"-"+s.sh+s.sm+"-"+s.code).replace(/[^A-Za-z0-9-]/g,"")+"@term4",n    start:icsLocal(s.date,s.sh,s.sm,0),end:icsLocal(s.date,s.sh,s.sm,90),n    summary:s.code+" · "+META[s.code].name,n    desc:"S"+s.n+" · "+s.slot+(s.venue?" · "+s.venue:""),alarms:["-PT30M"]};n}nfunction addClassCal(k){n  var s=mySessions().find(function(x){return skey(x)===k;});n  if(!s){showToast("Session not found");return;}n  downloadICS(s.code+"-"+s.date+".ics",[classEvent(s)]);n}nn nvar STATUS_PRESETS=[["📚","Studying"],["☕","Free to meet"],["🍔","Lunch"],["🏠","At home"],["😴","Resting"],["🎯","Focusing"],["🎧","In the zone"],["✈️","Travelling"]];nvar STATUS_DURS=[["1 hour",36e5],["4 hours",144e5],["Today",-1],["This week",-2],["No expiry",0]];nvar myStatus=null,stDur=144e5;nfunction loadMyStatus(){try{myStatus=JSON.parse(localStorage.getItem("t4_status")||"null");}catch(e){myStatus=null;}}nfunction saveMyStatusLocal(){try{if(myStatus)localStorage.setItem("t4_status",JSON.stringify(myStatus));else localStorage.removeItem("t4_status");}catch(e){}}nfunction statusActive(s){return s&&s.text&&(!s.until||Date.now()<s.until);}nfunction statusPillHTML(s){n  if(!statusActive(s))return"";n  return '<div class="status-pill">'+(s.emoji?'<span>'+s.emoji+'</span>':'')+'<span class="sp-t">'+s.text+'</span></div>';n}nfunction renderMyStatus(){n  var el=document.getElementById("h-status");if(!el)return;n  if(!prefs.rollNo){el.innerHTML="";return;}n  if(statusActive(myStatus)){n    var until=myStatus.until?(" · clears "+stUntilLabel(myStatus.until)):"";n    el.innerHTML='<div class="h-status-strip set" onclick="openStatus()">'n      +'<span class="hss-emoji">'+(myStatus.emoji||"💬")+'</span>'n      +'<div class="hss-body"><div class="hss-t">'+myStatus.text+'</div><div class="hss-s">Your status'+until+' · tap to edit</div></div>'n      +'<button class="hss-x" onclick="event.stopPropagation();clearStatus()">Clear</button></div>';n  } else {n    el.innerHTML='<div class="h-status-strip" onclick="openStatus()">'n      +'<span class="hss-emoji">💬</span>'n      +'<div class="hss-body"><div class="hss-t">Set a status</div><div class="hss-s">Tell friends you're free, studying, or out u2014 they'll see it on your schedule</div></div>'n      +'<span class="hss-x">＋</span></div>';n  }n}nfunction stUntilLabel(ms){n  var d=new Date(ms),now=new Date();n  if(d.toDateString()===now.toDateString())return d.toLocaleTimeString("en-IN",{hour:"2-digit",minute:"2-digit"});n  return d.getDate()+" "+MO[d.getMonth()];n}nfunction buildStatusModal(){n  document.getElementById("st-presets").innerHTML=STATUS_PRESETS.map(function(p,i){n    return '<div class="st-chip" data-sti="'+i+'" onclick="stPick('+i+')"><span class="ste">'+p[0]+'</span><span>'+p[1]+'</span></div>';n  }).join("");n  document.getElementById("st-durs").innerHTML=STATUS_DURS.map(function(p,i){n    return '<button class="st-dur'+(p[1]===stDur?" on":"")+'" data-std="'+i+'" onclick="stPickDur('+i+')">'+p[0]+'</button>';n  }).join("");n}nfunction stPick(i){n  var p=STATUS_PRESETS[i];if(!p)return;n  document.getElementById("st-emoji").value=p[0];n  document.getElementById("st-text").value=p[1];n  stPreview();n}nfunction stPickDur(i){stDur=STATUS_DURS[i][1];document.querySelectorAll("#st-durs .st-dur").forEach(function(b,j){b.classList.toggle("on",j===i);});}nfunction stPreview(){n  var txt=document.getElementById("st-text").value.trim().toLowerCase();n  document.querySelectorAll("#st-presets .st-chip").forEach(function(c){n    var i=Number(c.dataset.sti);c.classList.toggle("on",STATUS_PRESETS[i][1].toLowerCase()===txt);n  });n}nfunction untilFromDur(dur){n  if(dur===0)return 0;n  if(dur>0)return Date.now()+dur;n  var d=new Date();n  if(dur===-1){d.setHours(23,59,59,0);return d.getTime();}        n  var add=(7-d.getDay())%7;d.setDate(d.getDate()+add);d.setHours(23,59,59,0);return d.getTime(); n}nfunction openStatus(){n  stDur=myStatus&&myStatus.until?(myStatus.until-Date.now()>0?(myStatus.until-Date.now()):144e5):144e5;n  stDur=144e5; n  buildStatusModal();n  document.getElementById("st-emoji").value=(myStatus&&myStatus.emoji)||"";n  document.getElementById("st-text").value=(myStatus&&myStatus.text)||"";n  stPreview();n  var ov=document.getElementById("stov");if(ov)ov.classList.add("open");n}nfunction closeStatus(){var ov=document.getElementById("stov");if(ov)ov.classList.remove("open");}nfunction saveStatus(){n  if(!prefs.rollNo){alert("Set your roll number first (Settings).");return;}n  var text=document.getElementById("st-text").value.trim();n  if(!text){clearStatus();return;}n  var emoji=document.getElementById("st-emoji").value.trim();n  var until=untilFromDur(stDur);n  myStatus={emoji:emoji,text:text,until:until};n  saveMyStatusLocal();renderMyStatus();closeStatus();n  enqueue({action:"setStatus",rollNo:prefs.rollNo,emoji:emoji,text:text,until:until||""}); flushQueue();n  showToast("Status set "+(emoji||"💬"));n}nfunction clearStatus(){n  myStatus=null;saveMyStatusLocal();renderMyStatus();closeStatus();n  if(prefs.rollNo){ enqueue({action:"setStatus",rollNo:prefs.rollNo,text:""}); flushQueue(); }n}nfunction fetchMyStatus(){n  if(!prefs.rollNo)return;n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"getStatus",rollNo:prefs.rollNo}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      if(d&&d.ok){ myStatus=statusActive(d.data)?d.data:null; saveMyStatusLocal(); renderMyStatus(); }n    }).catch(function(){});n}nn nfunction ttSnapshot(){return mySessions().map(function(s){return s.date+"|"+s.code+"|"+s.section+"|"+s.slot;});}nfunction baselineSnapshot(){try{localStorage.setItem("t4_tt_snap",JSON.stringify(ttSnapshot()));}catch(e){}}nfunction fmtSnapItem(k){var p=k.split("|");var d=new Date(p[0]+"T00:00:00+05:30");return p[1]+" · "+DS[d.getDay()]+" "+d.getDate()+" "+MO[d.getMonth()]+" · "+p[3];}nfunction renderChanges(){n  var el=document.getElementById("h-changes");if(!el)return;n  var cur=ttSnapshot(),prevRaw=null;n  try{prevRaw=localStorage.getItem("t4_tt_snap");}catch(e){}n  if(!prevRaw){baselineSnapshot();el.innerHTML="";return;}            n  var prev=[];try{prev=JSON.parse(prevRaw)||[];}catch(e){prev=[];}n  var prevSet={},curSet={};n  prev.forEach(function(k){prevSet[k]=1;});cur.forEach(function(k){curSet[k]=1;});n  var added=cur.filter(function(k){return !prevSet[k];});n  var removed=prev.filter(function(k){return !curSet[k];});n  if(!added.length&&!removed.length){el.innerHTML="";return;}n  var rows=added.slice(0,5).map(function(k){return '<div class="cb-row"><span class="cb-tag add">added</span>'+fmtSnapItem(k)+'</div>';})n    .concat(removed.slice(0,5).map(function(k){return '<div class="cb-row"><span class="cb-tag rem">removed</span>'+fmtSnapItem(k)+'</div>';})).join("");n  var more=(added.length+removed.length)-Math.min(added.length,5)-Math.min(removed.length,5);n  el.innerHTML='<div class="changes-banner"><div class="cb-top"><span class="cb-ico">🔔</span>'n    +'<span class="cb-t">Your timetable changed</span>'n    +'<button class="cb-x" onclick="dismissChanges()">Got it</button></div>'n    +rows+(more>0?'<div class="cb-row" style="color:var(--t3)">+'+more+' moreu2026</div>':'')+'</div>';n}nfunction dismissChanges(){baselineSnapshot();var el=document.getElementById("h-changes");if(el)el.innerHTML="";}nn nvar cdTimer=null;nfunction startBannerCountdown(targetMs,ongoingEndMs){n  if(cdTimer){clearInterval(cdTimer);cdTimer=null;}n  function tick(){n    var pill=document.getElementById("nb-countdown");if(!pill){if(cdTimer)clearInterval(cdTimer);return;}n    var now=Date.now();n    if(ongoingEndMs&&now>=targetMs&&now<=ongoingEndMs){pill.textContent="ends in "+fmtDur(ongoingEndMs-now);return;}n    var diff=targetMs-now;n    if(diff<=0){pill.textContent="now";return;}n    pill.textContent="in "+fmtDur(diff);n  }n  tick();cdTimer=setInterval(tick,1000);n}nfunction fmtDur(ms){n  var s=Math.floor(ms/1000),h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=s%60;n  if(h>0)return h+"h "+pad(m)+"m";n  if(m>0)return m+"m "+pad(sec)+"s";n  return sec+"s";n}nvar MILESTONES=[3,5,7,10,14,21,30,45,60];nfunction celebrateStreak(streak){n  if(MILESTONES.indexOf(streak)<0)return;n  var last=0;try{last=Number(localStorage.getItem("t4_streak_celeb"))||0;}catch(e){}n  if(streak<=last)return;n  try{localStorage.setItem("t4_streak_celeb",String(streak));}catch(e){}n  confetti();showToast("🔥 "+streak+"-day streak! Keep it up.");n}nfunction confetti(){n  var box=document.getElementById("confetti");if(!box)return;n  var bits=["🎉","✨","🔥","🎊","⭐","💚"];box.innerHTML="";n  for(var i=0;i<26;i++){n    var s=document.createElement("span");s.className="cf-bit";n    s.textContent=bits[i%bits.length];n    s.style.left=(Math.random()*100)+"%";n    s.style.animationDelay=(Math.random()*0.4)+"s";n    s.style.fontSize=(12+Math.random()*14)+"px";n    box.appendChild(s);n  }n  box.classList.add("go");n  setTimeout(function(){box.classList.remove("go");box.innerHTML="";},2100);n}nfunction renderHome(){n  var dismissed = false;n  try{ dismissed = localStorage.getItem("t4_install_dismissed") === "1"; }catch(e){}n  var isStandalone = window.navigator.standalone || window.matchMedia('(display-mode: standalone)').matches;n  var hint = document.getElementById("gp-install-hint");n  if(hint) {n    if(!dismissed && !isStandalone) {n      hint.style.display = "flex";n    } else {n      hint.style.display = "none";n    }n  }nn  var now=Date.now(),tm=todayMs();n  n  n  var totalTermMs = TERM_END_MS - TERM_START_MS;n  var termElapsed = now - TERM_START_MS;n  var termPct = 0;n  var termDaysText = "";n  if(now < TERM_START_MS){n    termPct = 0;n    termDaysText = Math.ceil((TERM_START_MS - now)/864e5) + "d until term starts";n  } else if(now > TERM_END_MS){n    termPct = 100;n    termDaysText = "Term complete! 🎉";n  } else {n    termPct = Math.round((termElapsed / totalTermMs) * 100);n    termDaysText = Math.ceil((TERM_END_MS - now)/864e5) + "d left in term (" + termPct + "% elapsed)";n  }n  var elTermPct = document.getElementById("h-term-pct");n  var elTermFill = document.getElementById("h-term-fill");n  var elTermLabel = document.getElementById("h-term-elapsed");n  if(elTermPct) elTermPct.textContent = termPct + "%";n  if(elTermFill) elTermFill.style.width = termPct + "%";n  if(elTermLabel) elTermLabel.textContent = termDaysText;nn  var my=mySessions(),ts=todayStr(),done=my.filter(function(s){return s.date<ts;}).length;n  var totP=0,totA=0;my.forEach(function(s){var st=attendance[skey(s)];if(st==="present")totP++;else if(st==="absent")totA++;});n  n  n  var marked = totP + totA;n  var globalPct = marked ? Math.round(totP / marked * 100) : 0;n  var attColor = globalPct >= 75 ? "var(--ok)" : globalPct >= 65 ? "var(--warn)" : "var(--bad)";n  n  n  var minBuffer = 999;n  prefs.courses.forEach(function(c){n    if(courseTotal(c) > 0) {n      var st = attStats(c);n      if(st.missLeft < minBuffer) minBuffer = st.missLeft;n    }n  });n  if(minBuffer === 999) minBuffer = MAX_MISS;n  var bunkClass = minBuffer <= 0 ? "danger" : minBuffer === 1 ? "warn" : "safe";n  var cardGlowClass = minBuffer <= 0 ? "danger-glow" : minBuffer === 1 ? "danger-glow" : "safe-glow";n  n  n  var streak = hmStreak();n  celebrateStreak(streak);nn  n  var sessionsPct = Math.round(done / (my.length || 1) * 100);nn  n  var heroContainer = document.getElementById("h-hero-v2");n  if(heroContainer){n    heroContainer.innerHTML = n       '<div class="hcard-v2"><div class="hc-content">'n         +'<div class="hc-title">Attendance</div>'n         +'<div class="hc-value">'+globalPct+'%</div>'n         +'<div class="hc-sub">'+totP+' present · '+totA+' absent</div>'n         +'</div><div class="hc-visual">'+svgRingLarge(totP, marked, attColor)+'</div></div>'n       n       +'<div class="hcard-v2 '+cardGlowClass+'"><div class="hc-content">'n         +'<div class="hc-title" style="display:flex;align-items:center;gap:6px;">Bunk-o-Meter <span class="info-trigger" onclick="showInfoModal('bunk', event)">ⓘ</span></div>'n         +'<div class="hc-value">'+(minBuffer <= 0 ? 'Danger! 🚨' : minBuffer === 1 ? '1 skip left' : minBuffer+' skips left')+'</div>'n         +'<div class="hc-sub">Min buffer across courses</div>'n         +'<div class="bunk-slider-wrap"><div class="bunk-slider-track"><div class="bunk-slider-fill '+bunkClass+'" style="width:'+Math.max(0, Math.min(100, (minBuffer / MAX_MISS) * 100))+'%"></div></div></div>'n         +'</div></div>'n       n       +'<div class="hcard-v2"><div class="hc-content">'n         +'<div class="hc-title">Streaks</div>'n         +'<div class="hc-value streak-value"><span class="streak-flame">🔥</span>'+streak+' days</div>'n         +'<div class="hc-sub">Active attendance streak</div>'n         +'</div></div>'n       n       +'<div class="hcard-v2"><div class="hc-content">'n         +'<div class="hc-title">Sessions Progress</div>'n         +'<div class="hc-value">'+sessionsPct+'%</div>'n         +'<div class="hc-sub">'+done+' of '+my.length+' classes done</div>'n         +'<div class="bunk-slider-wrap"><div class="bunk-slider-track"><div class="bunk-slider-fill" style="width:'+sessionsPct+'%; background:var(--acc)"></div></div></div>'n         +'</div></div>';n  }nn  n  var up=my.filter(function(s){return sessionMs(s)+90*6e4 > now;}).sort(function(a,b){return sessionMs(a)-sessionMs(b);});n  var bw=document.getElementById("h-banner");n  if(up.length){n    var n=up[0],nd=new Date(n.date+"T00:00:00+05:30");n    var isOngoing = now >= sessionMs(n) && now <= sessionMs(n)+90*6e4;n    var when=n.date===ts?"today":(nd.getTime()===tm+864e5?"tomorrow":DS[nd.getDay()]+" "+nd.getDate()+" "+MO[nd.getMonth()]);n    var late=n.late?'<span class="late">late</span>':'';n    var label = isOngoing ? '<span class="pulse-live"></span>Ongoing now' : 'Next up';n    var cardClass = isOngoing ? 'nbanner ongoing' : 'nbanner';n    bw.innerHTML='<div class="'+cardClass+'" style="--cc:'+CCOLOR[n.code]+'"><span class="nb-dot"></span><div><div class="nb-l">'+label+'</div><div class="nb-c">'+META[n.code].name+'</div><div class="nb-t">S'+n.n+' · '+n.slot+late+' · '+when+' · <span id="nb-countdown">u2026</span></div></div><div class="nb-p">S'+n.n+'/'+courseTotal(n.code)+'</div></div>';n    startBannerCountdown(sessionMs(n),sessionMs(n)+90*6e4);n  } else { bw.innerHTML=''; if(cdTimer){clearInterval(cdTimer);cdTimer=null;} }n  n  var nudge=document.getElementById("h-nudge");n  if(nudge){n    var unm=my.filter(function(s){return s.date<ts&&!attendance[skey(s)];});n    if(unm.length){n      var recent=unm.map(function(s){return s.date;}).sort();recent=recent[recent.length-1];n      nudge.innerHTML='<div class="nudge"><span class="nudge-ico">⚠</span>'n        +'<div class="nudge-body"><div class="nudge-t">'+unm.length+' past class'+(unm.length>1?'es':'')+' unmarked</div>'n        +'<div class="nudge-s">Mark them so your attendance buffer stays accurate</div></div>'n        +'<button class="nudge-cta" onclick="openUnmarked()">Review</button></div>';n    } else nudge.innerHTML='';n  }n  document.getElementById("h-today").innerHTML=renderDay(tm,"Today",true);n  document.getElementById("h-tomorrow").innerHTML=renderDay(tm+864e5,"Tomorrow",false);n}n nvar toastTimer=null;nfunction showToast(msg,undoFn){n  var el=document.getElementById("toast");if(!el)return;n  el.innerHTML='<span>'+msg+'</span>'+(undoFn?'<button class="toast-undo" id="toast-undo">Undo</button>':'');n  el.classList.add("show");n  if(undoFn){document.getElementById("toast-undo").onclick=function(){undoFn();hideToast();};}n  clearTimeout(toastTimer);toastTimer=setTimeout(hideToast,6000);n}nfunction hideToast(){var el=document.getElementById("toast");if(el)el.classList.remove("show");}nnfunction rerenderAfterMark(){n  renderHome();n  if(document.getElementById("p-att").classList.contains("on"))renderAtt();n  if(document.getElementById("p-week").classList.contains("on"))renderWeek();n  if(document.getElementById("unmarked-ov")&&document.getElementById("unmarked-ov").classList.contains("open"))renderUnmarked();n  refreshOpenTL();n}nfunction skLabel(k){var p=String(k).split("_");return p[0]+" S"+(p[2]||"");}n nfunction applyMark(k,value,src){n  if(!value)delete attendance[k];else attendance[k]=value;n  try{if(navigator.vibrate)navigator.vibrate(9);}catch(e){}n  saveA();rerenderAfterMark();n  if(prefs.rollNo)syncMark(k,value||null,src||"manual");n}nfunction mark(k,status,src){n  var prev=attendance[k]||"";                       n  var ns=attendance[k]===status?"":status;          n  applyMark(k,ns,src||"manual");n  showToast(ns?(skLabel(k)+" → "+ns):(skLabel(k)+" cleared"),function(){applyMark(k,prev,"undo");});n}nfunction renderUnmarked(){n  var el=document.getElementById("unmarked-full-list");if(!el)return;n  var ts=todayStr();n  var un=mySessions().filter(function(s){return s.date<ts&&!attendance[skey(s)];});n  un.sort(function(a,b){return a.date>b.date?-1:a.date<b.date?1:(b.sh*60+b.sm)-(a.sh*60+a.sm);});n  if(!un.length){el.innerHTML='<div class="free" style="margin-top:10px">All caught up 🌿</div>';return;}n  var html = un.map(function(s){n    var d=new Date(s.date+"T00:00:00+05:30");n    var lbl = DF[d.getDay()]+", "+d.getDate()+" "+MO[d.getMonth()];n    return '<div style="margin-bottom:8px"><div class="daylabel" style="margin:4px 0">'+lbl+'</div>'+scard(s,true)+'</div>';n  }).join("");n  el.innerHTML=html;n}nfunction openUnmarked(){ renderUnmarked(); var ov=document.getElementById("unmarked-ov"); if(ov)ov.classList.add("open"); }nfunction closeUnmarked(){ var ov=document.getElementById("unmarked-ov"); if(ov)ov.classList.remove("open"); }nfunction bulkMarkPresent(){n  var ts=todayStr();n  var un=mySessions().filter(function(s){return s.date<ts&&!attendance[skey(s)];});n  if(!un.length){showToast("No unmarked past sessions");return;}n  if(!confirm("Mark "+un.length+" past unmarked sessions as Present?"))return;n  var keys=un.map(function(s){return skey(s);});n  keys.forEach(function(k){attendance[k]="present";if(prefs.rollNo)syncMark(k,"present","bulk");});n  saveA();rerenderA