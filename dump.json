width: 900px) {n  .gp-grid {n    grid-template-columns: 1fr;n  }n}n.gp-inspector-panel {n  display: flex;n  flex-direction: column;n}n.gp-member-pill {n  font-size: 8px;n  background: var(--s2);n  border: .5px solid var(--b2);n  border-radius: 12px;n  padding: 2px 7px;n  color: var(--t2);n  display: inline-block;n  margin-right: 4px;n  margin-bottom: 4px;n}n.gp-slot-row {n  display: flex;n  align-items: center;n  gap: 10px;n  padding: 8px 0;n  border-bottom: .5px solid var(--b1);n}n.gp-slot-row:last-child {n  border-bottom: none;n}n.gp-slot-time {n  font-size: 10px;n  color: var(--t3);n  width: 90px;n  flex-shrink: 0;n}n.gp-slot-status {n  flex: 1;n  display: flex;n  flex-wrap: wrap;n  gap: 4px;n}n.gp-user-dot {n  font-size: 9px;n  padding: 2px 6px;n  border-radius: 4px;n  font-family: 'Syne', sans-serif;n  font-weight: 500;n}n.gp-user-dot.free {n  background: rgba(46, 196, 182, 0.12);n  color: #2ec4b6;n  border: .5px solid rgba(46, 196, 182, 0.3);n}n.gp-user-dot.busy {n  background: rgba(226, 75, 74, 0.12);n  color: var(--bad);n  border: .5px solid rgba(226, 75, 74, 0.3);n}n.gp-insight-card {n  background: var(--s2);n  border: .5px solid var(--b2);n  border-radius: 8px;n  padding: 10px 12px;n  cursor: pointer;n  transition: .15s;n}n.gp-insight-card:hover {n  border-color: var(--acc);n  background: rgba(212,242,68,0.02);n}n.duration-selector {n  display: flex;n  background: var(--s1);n  border: 0.5px solid var(--b2);n  border-radius: 12px;n  padding: 2px;n}n.dur-btn {n  background: transparent;n  border: none;n  color: var(--t3);n  font-size: 10px;n  font-weight: 600;n  padding: 4px 10px;n  border-radius: 10px;n  cursor: pointer;n  transition: all 0.2s ease;n}n.dur-btn:hover {n  color: var(--t2);n}n.dur-btn.active {n  background: var(--acc);n  color: var(--b1);n}nn n.term-progress-wrap{background:var(--s1);border:.5px solid var(--b1);border-radius:var(--r);padding:10px 14px;margin-bottom:12px}n.tp-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}n.tp-label{font-size:9px;color:var(--t3);text-transform:uppercase;letter-spacing:.07em}n.tp-pct{font-family:'Syne',sans-serif;font-size:11px;font-weight:700;color:var(--acc)}n.tp-bar{height:4px;background:var(--s3);border-radius:2px;overflow:hidden;position:relative}n.tp-fill{height:100%;background:linear-gradient(90deg,var(--acc),#7f77dd);border-radius:2px;width:0%;transition:width 1s ease-out;position:relative}n.tp-fill::after{content:'';position:absolute;top:0;right:0;bottom:0;width:30px;background:rgba(255,255,255,0.15);filter:blur(3px);transform:skewX(-20deg);animation:tp-shimmer 2s infinite}n@keyframes tp-shimmer{0%{left:-30px}100%{left:100%}}nn n.hero-v2{display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:12px}n@media(min-width:480px){.hero-v2{grid-template-columns:1fr 1fr}}n.hcard-v2{background:var(--s1);border:.5px solid var(--b1);border-radius:var(--r);padding:14px 16px;display:flex;align-items:center;justify-content:space-between;position:relative;overflow:hidden;transition:.15s}n.hcard-v2.danger-glow{box-shadow:0 0 15px rgba(226,75,74,0.18);border-color:rgba(226,75,74,0.3)}n.hcard-v2.safe-glow{box-shadow:0 0 15px rgba(101,207,160,0.08);border-color:rgba(101,207,160,0.15)}n.hc-content{flex:1;min-width:0;display:flex;flex-direction:column}n.hc-title{font-size:9px;color:var(--t3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px}n.hc-value{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;letter-spacing:-.03em;line-height:1.1}n.hc-sub{font-size:10px;color:var(--t2);margin-top:4px}n.hc-visual{flex-shrink:0;margin-left:12px}nn n.bunk-slider-wrap{margin-top:8px;width:100%}n.bunk-slider-track{height:5px;background:var(--s3);border-radius:2.5px;position:relative;overflow:hidden}n.bunk-slider-fill{height:100%;border-radius:2.5px;transition:width 0.4s ease-out;position:relative}n.bunk-slider-fill.safe{background:var(--ok)}n.bunk-slider-fill.warn{background:var(--warn)}n.bunk-slider-fill.danger{background:var(--bad)}nn n.streak-value{display:flex;align-items:center;gap:6px}n.streak-flame{font-size:20px;animation:flame-pulse 1.2s infinite alternate}n@keyframes flame-pulse{n  0%{transform:scale(0.9);filter:drop-shadow(0 0 2px var(--warn))}n  100%{transform:scale(1.15);filter:drop-shadow(0 0 8px #ef9f27)}n}nn n.pulse-live {n  display: inline-block;n  width: 7px;n  height: 7px;n  background-color: var(--ok);n  border-radius: 50%;n  position: relative;n  margin-right: 6px;n  vertical-align: middle;n}n.pulse-live::after {n  content: '';n  position: absolute;n  inset: -3px;n  border: 1.5px solid var(--ok);n  border-radius: 50%;n  animation: radar-pulse 1.5s infinite ease-out;n}n@keyframes radar-pulse {n  0% { transform: scale(0.6); opacity: 1; }n  100% { transform: scale(2.2); opacity: 0; }n}n.nb-l .pulse-live {n  margin-top: -2px;n}n</style>n</head>n<body>n<div id="onboard">n  <div class="ob">n    <div class="ob-tag">XLRI Delhi NCR · Term IV · 2025u201327</div>n    <div class="ob-h">Your term,<br>fully tracked.</div>n    <div class="ob-p">Timetable, attendance, and leave planner u2014 live from the master sheet. Attendance syncs across devices with your roll number.</div>n    <div class="ob-restore">n      <div class="ob-l" style="margin-bottom:8px">↩ Returning? Restore your setup</div>n      <div class="ob-restore-row">n        <div class="sug-wrap" style="flex:1;">n          <input type="text" id="ob-restore-roll" class="ob-input" placeholder="B25349" autocomplete="off" oninput="renderSug('ob-restore-sug',this.value)" onfocus="trackOnboardFocus(this)" style="text-transform:uppercase;margin:0;width:100%">n          <div id="ob-restore-sug" class="sug-box"></div>n        </div>n        <button class="ob-restore-btn" onclick="doRestore()">Restore</button>n      </div>n      <div id="ob-restore-hint" style="font-size:10px;color:var(--t3);margin-top:6px"></div>n    </div>n    <div class="ob-or">or set up new</div>n    <div class="ob-l">Roll number</div>n    <div class="sug-wrap">n      <input type="text" id="ob-roll" class="ob-input" placeholder="B25301" autocomplete="off" oninput="obReady();renderSug('ob-roll-sug',this.value)" onfocus="trackOnboardFocus(this)" style="text-transform:uppercase">n      <div id="ob-roll-sug" class="sug-box"></div>n    </div>n    <div class="ob-hint">B25301 u2013 B25480</div>n    <div class="ob-l">Section</div>n    <div class="secrow"><button class="secbtn" data-s="E" onclick="obSec(this)">Section E</button><button class="secbtn" data-s="F" onclick="obSec(this)">Section F</button></div>n    <div class="ob-l">Your courses</div>n    <div class="cgrid" id="ob-cgrid"></div>n    <button class="cta" id="ob-cta" disabled onclick="obSave()">Continue →</button>n    n    n    <div class="ob-numpad" id="ob-numpad" style="display:none;">n      <div class="np-grid">n        <button class="np-btn" onclick="handleNumpadPress('1')">1</button>n        <button class="np-btn" onclick="handleNumpadPress('2')">2</button>n        <button class="np-btn" onclick="handleNumpadPress('3')">3</button>n        <button class="np-btn" onclick="handleNumpadPress('4')">4</button>n        <button class="np-btn" onclick="handleNumpadPress('5')">5</button>n        <button class="np-btn" onclick="handleNumpadPress('6')">6</button>n        <button class="np-btn" onclick="handleNumpadPress('7')">7</button>n        <button class="np-btn" onclick="handleNumpadPress('8')">8</button>n        <button class="np-btn" onclick="handleNumpadPress('9')">9</button>n        <button class="np-btn" onclick="handleNumpadPress('B25')" style="font-size:11px;color:var(--acc)">B25</button>n        <button class="np-btn" onclick="handleNumpadPress('0')">0</button>n        <button class="np-btn" onclick="handleNumpadPress('back')">⌫</button>n      </div>n    </div>n  </div>n</div>nnn<div id="view-mode" style="display:none;min-height:100vh;background:var(--bg);color:var(--t1)">n  <div class="top" style="position:sticky;top:0;z-index:20">n    <div class="top-l">n      <span class="top-logo" id="vm-name">Timetable</span>n      <span class="top-badge" id="vm-badge">u2014</span>n    </div>n    <div class="top-r">n      <a id="vm-setup-link" class="iconbtn" href="#" style="text-decoration:none;font-size:11px;white-space:nowrap">Set up yours →</a>n    </div>n  </div>n  <div class="content">n    <div id="vm-loading" style="display:flex;align-items:center;justify-content:center;height:50vh;gap:12px;flex-direction:column">n      <div style="font-size:28px;animation:spin 1s linear infinite">⟳</div>n      <div style="color:var(--t2);font-size:12px">Loading timetableu2026</div>n    </div>n    <div id="vm-error" class="errbar" style="display:none"></div>n    <div id="vm-content" style="display:none">n      <div id="vm-next-banner"></div>n      n      <div style="display:flex;gap:6px;margin-bottom:16px">n        <button class="secbtn on" data-vmtab="today" onclick="switchVmTab('today',this)" style="font-size:12px;padding:8px 14px">Today</button>n        <button class="secbtn" data-vmtab="week" onclick="switchVmTab('week',this)" style="font-size:12px;padding:8px 14px">Week</button>n      </div>n      n      <div id="vm-today-pane">n        <div id="vm-today"></div>n        <div id="vm-tomorrow" style="margin-top:16px"></div>n        <div id="vm-exams" style="margin-top:16px"></div>n      </div>n      n      <div id="vm-week-pane" style="display:none">n        <div class="wknav">n          <button class="wkbtn" id="vm-pw" onclick="shiftVmWk(-1)">←</button>n          <span class="wkl" id="vm-wkl"></span>n          <button class="wkbtn" id="vm-nw" onclick="shiftVmWk(1)">→</button>n        </div>n        <div class="wkgrid" id="vm-wkgrid"></div>n      </div>n    </div>n    <div class="footer" style="padding-bottom:30px">n      Read-only shared view ·n      <a id="vm-cta-link" href="#" style="color:var(--acc);text-decoration:none">Set up your own timetable →</a>n    </div>n  </div>n</div>nn<div id="shell" style="display:none">n  <nav id="sidebar" style="display:none">n    <div class="sb-logo">Term IV</div>n    <div class="sb-badge" id="sb-badge">Sec E</div>n    <div class="sb-nav">n      <button class="sb-item on" data-p="home" onclick="nav('home',this)">◫ Home</button>n      <button class="sb-item" data-p="week" onclick="nav('week',this)">▦ Week</button>n      <button class="sb-item" data-p="att" onclick="nav('att',this)">✓ Attend</button>n      <button class="sb-item" data-p="leave" onclick="nav('leave',this)">⊘ Leave</button>n      <button class="sb-item" data-p="prog" onclick="nav('prog',this)">◴ Progress</button>n    </div>n    <div class="sb-footer">n      <button class="sb-item" id="refresh-btn-sb" onclick="refreshNow()"><span class="refresh-ico">⟳</span> Refresh</button>n      <button class="sb-item" onclick="openTripPlanner()">✈️ Solo Trip Planner</button>n      <button class="sb-item" onclick="openExams()">📌 Assessments</button>n      <button class="sb-item" onclick="shareMyTimetable()">↗ Share timetable</button>n      <button class="sb-item" onclick="openSheet()">🔗 Master sheet</button>n      <button class="sb-item" onclick="openIdea()">💡 Submit idea</button>n      <button class="sb-item" onclick="openF()">👥 Friends</button>n      <button class="sb-item" onclick="openS()">⚙ Settings</button>n      <div class="sb-sync" id="sb-sync"></div>n    </div>n  </nav>nn  <div id="main-wrap">n    <div class="top">n      <div class="top-l"><span class="top-logo">Term IV</span><span class="top-badge" id="top-badge">Sec E</span></div>n      <div class="top-r">n        <button class="iconbtn" id="refresh-btn" onclick="refreshNow()" title="Refresh from sheet"><span class="refresh-ico">⟳</span></button>n        <button class="iconbtn" onclick="openF()" title="Friends">👥</button>n        <button class="iconbtn" onclick="openMenu()" title="More Options">⋮</button>n      </div>n    </div>n    <div class="content">n      <div class="synced" id="synced"></div>n      <div id="errbox"></div>nn      <div class="panel on" id="p-home">