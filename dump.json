ends();n    })n    .catch(function(){n      friendsLoading=false;n      renderFriends();n    });n}nn nfunction rosterMatches(q){n  q=(q||"").trim().toUpperCase();if(!q)return [];n  var out=[];n  for(var roll in ROSTER){n    var nm=ROSTER[roll].n||"";n    if(roll.indexOf(q)===0||nm.toUpperCase().indexOf(q)>=0){n      out.push({roll:roll,name:nm,sec:ROSTER[roll].s||""});n      if(out.length>=7)break;n    }n  }n  return out;n}nfunction renderSug(boxId,q){n  var box=document.getElementById(boxId);if(!box)return;n  var m=(""+(q||"")).trim()?rosterMatches(q):[];n  if(!m.length){box.style.display="none";box.innerHTML="";return;}n  box.style.display="block";n  box.innerHTML=m.map(function(x){n    return '<div class="sug-item" data-roll="'+x.roll+'" data-name="'+String(x.name).replace(/"/g,"&quot;")+'">'n      +'<span class="sug-roll">'+x.roll+'</span><span class="sug-name">'+x.name+'</span><span class="sug-sec">'+x.sec+'</span></div>';n  }).join("");n}nfunction onFriendRollInput(){n  var v=document.getElementById("f-roll").value;n  renderSug("f-roll-sug",v);n  var r=v.trim().toUpperCase(),hint=document.getElementById("f-add-hint");n  if(ROSTER[r]){hint.style.color="var(--t2)";hint.textContent="✓ "+ROSTER[r].n+" · Sec "+ROSTER[r].s;}n  else hint.textContent="";n}nn nfunction onSearchInput(){renderSug("f-search-sug",document.getElementById("f-search").value);}nfunction searchRoll(){n  var box=document.getElementById("f-search-sug");if(box){box.style.display="none";box.innerHTML="";}n  var q=document.getElementById("f-search").value.trim().toUpperCase(),roll=q;n  var res=document.getElementById("f-search-result");n  if(!/^B25[0-9]{3}$/.test(roll)){n    var m=rosterMatches(q);n    if(m.length)roll=m[0].roll;n    else{res.innerHTML='<div class="f-card"><div class="f-free">No student matches "'+q+'".</div></div>';return;}n  }n  if(!ROSTER[roll]){res.innerHTML='<div class="f-card"><div class="f-free">Unknown roll '+roll+'.</div></div>';return;}n  res.innerHTML='<div class="f-card"><div class="f-name">'+ROSTER[roll].n+'</div><div class="f-roll">'+roll+' · Sec '+ROSTER[roll].s+'</div><div class="f-free">Looking up scheduleu2026</div></div>';n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"getManyPrefs",rollNos:[roll]}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      var p=(d&&d.ok&&d.data)?d.data[roll]:null,status;n      if(!p||!p.courses||!p.courses.length){n        status='<div class="f-free">Hasn't set up the app yet u2014 no schedule to show.</div>';n      } else {n        var pf={section:p.section,courses:p.courses,courseSections:p.courseSections};n        var cur=friendNow(pf),nxt=friendNext(pf);n        if(cur)status='<div class="f-now">In '+cur.code+' now · '+cur.slot+'</div>';n        else if(nxt){var nd=new Date(nxt.date+"T00:00:00+05:30");var when=nxt.date===todayStr()?"today":(nd.getTime()===todayMs()+864e5?"tomorrow":nd.getDate()+" "+MO[nd.getMonth()]);status='<div class="f-next">Next: '+nxt.code+' · '+nxt.slot+' · '+when+'</div>';}n        else status='<div class="f-free">No upcoming classes</div>';n      }n      var addBtn=(roll===(prefs.rollNo||""))?'':'<button class="f-del" onclick="quickAddFriend(''+roll+'')">+ Friend</button>';n      var sPill=(p&&p.status)?statusPillHTML(p.status):"";n      res.innerHTML='<div class="f-card"><div class="f-top"><div><div class="f-name">'+ROSTER[roll].n+'</div><div class="f-roll">'+roll+' · Sec '+ROSTER[roll].s+'</div></div>'+addBtn+'</div>'+status+sPill+'</div>';n    }).catch(function(){res.innerHTML='<div class="f-card"><div class="f-free">Server unreachable u2014 try refresh.</div></div>';});n}nfunction quickAddFriend(roll){n  if(friends.some(function(f){return f.rollNo===roll;})){alert(ROSTER[roll]?ROSTER[roll].n+" is already a friend.":"Already a friend.");return;}n  var f={id:Date.now().toString(),name:(ROSTER[roll]&&ROSTER[roll].n)||roll,rollNo:roll,pending:true};n  friends.push(f);saveFriends();syncFriendsList();renderFriends();fetchFriendPrefs([roll]);n  var sr=document.getElementById("f-search-result");if(sr)sr.innerHTML='<div class="f-card"><div class="f-free">Added '+f.name+' to friends ✓</div></div>';n}nnnnfunction refreshGroups(){n  if(!prefs.rollNo){myGroups=[];renderGroups();return Promise.resolve();}n  groupsLoading=true;n  renderGroups();n  return fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"getMyGroups",rollNo:prefs.rollNo}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      groupsLoading=false;n      if(d&&d.ok&&d.data){n        var pm=d.data.prefs||{};n        myGroups=(d.data.groups||[]).map(function(g){n          g.memberPrefs={};g.members.forEach(function(roll){g.memberPrefs[String(roll).toUpperCase()]=pm[String(roll).toUpperCase()];});n          return g;n        });n        try{localStorage.setItem("t4_my_groups",JSON.stringify(myGroups));}catch(e){}n      }n      renderGroups();n    }).catch(function(){n      groupsLoading=false;n      renderGroups();n    });n}nfunction renderGroups(){n  var el=document.getElementById("g-list");if(!el)return;n  var syncEl=document.getElementById("g-sync-status");n  if(syncEl)syncEl.style.display=groupsLoading?"inline":"none";n  var activeGroups = Array.isArray(myGroups) ? myGroups.filter(Boolean) : [];n  if(groupsLoading&&!activeGroups.length){n    el.innerHTML='<div class="g-card skeleton" style="animation:pulse 1.5s infinite ease-in-out;opacity:0.6;border-color:var(--b2)"><div style="padding:12px 14px"><div style="height:14px;width:140px;background:var(--s3);border-radius:4px;margin-bottom:8px"></div><div style="height:10px;width:100px;background:var(--s3);border-radius:3px"></div></div></div>'n      +'<div class="g-card skeleton" style="animation:pulse 1.5s infinite ease-in-out;opacity:0.4;border-color:var(--b2)"><div style="padding:12px 14px"><div style="height:14px;width:110px;background:var(--s3);border-radius:4px;margin-bottom:8px"></div><div style="height:10px;width:80px;background:var(--s3);border-radius:3px"></div></div></div>';n    return;n  }n  if(!activeGroups.length){el.innerHTML='<div class="f-free" style="margin-bottom:10px">No groups yet. Create one and share its code, or join a friend's with their code.</div>';return;}n  el.innerHTML=activeGroups.map(function(g){n    var inNow=0,freeNow=0;n    var membersList = Array.isArray(g.members) ? g.members.filter(Boolean) : [];n    var memberPrefs = g.memberPrefs || {};n    var rows=membersList.map(function(roll){n      roll=String(roll).toUpperCase();n      var nm=(ROSTER[roll]&&ROSTER[roll].n)||roll,p=memberPrefs[roll],st;n      if(!p||!p.courses||!p.courses.length){st='<span class="f-free">not set up</span>';}n      else{n        var pf={section:p.section,courses:p.courses,courseSections:p.courseSections};n        var cur=friendNow(pf),nxt=friendNext(pf);n        if(cur){inNow++;st='<span class="f-now">'+cur.code+' now</span>';}n        else if(nxt){var nd=new Date(nxt.date+"T00:00:00+05:30");var when=nxt.date===todayStr()?"today":(nd.getTime()===todayMs()+864e5?"tmrw":nd.getDate()+" "+MO[nd.getMonth()]);st='<span class="f-next">'+nxt.code+' '+nxt.slot+' · '+when+'</span>';freeNow++;}n        else{st='<span class="f-free">free</span>';freeNow++;}n      }n      var you=roll===(prefs.rollNo||"")?' <span class="gm-roll">(you)</span>':'';n      var semoji=(p&&statusActive(p.status))?(p.status.emoji||'💬')+' ':'';n      var stitle=(p&&statusActive(p.status))?String(p.status.text).replace(/"/g,'&quot;'):'';n      return '<div class="gm-row"><span class="gm-name" title="'+stitle+'">'+semoji+nm+you+' <span class="gm-roll">'+roll+'</span></span>'+st+'</div>';n    }).join("");n    var isOwner=g.owner===(prefs.rollNo||"");n    var ownerBtn=isOwner?'<button class="g-act" onclick="addMemberUI(''+g.code+'')">＋ Add member</button>':'';n    var ownerTag=isOwner?' · you own this':'';n    return '<div class="g-card" id="gc-'+g.code+'"><div class="g-head" data-gtog="'+g.code+'">'n      +'<div><div class="g-name">'+(g.name||"Group")+'</div><div class="g-meta">'+membersList.length+' members · code '+g.code+ownerTag+'</div></div><span class="g-chev">▾</span></div>'n      +'<div class="g-body" id="gbody-'+g.code+'" style="display:none">'n      +'<div class="g-summary">'+inNow+' in class now · '+freeNow+' free/upcoming</div>'+rowsn      +'<div class="g-actions">'+ownerBtn+'<button class="g-act" style="color:var(--acc);border-color:rgba(212,242,68,0.35)" onclick="openGroupPlanner(''+g.code+'')">📊 Trip Planner</button><button class="g-act" onclick="shareGroup(''+g.code+'')">↗ Share code</button><button class="g-act warn" onclick="leaveGroupUI(''+g.code+'')">Leave</button></div>'n      +'</div></div>';n  }).join("");n}nfunction createGroupUI(){n  if(!prefs.rollNo){alert("Set your roll number first (Settings).");return;}n  var name=prompt("Name your group (e.g. 'Marketing Squad'):");n  if(name===null)return;n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"createGroup",rollNo:prefs.rollNo,name:name}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      if(d&&d.ok){n        refreshGroups();n        alert("Group '" + d.name + "' created!nnShare this link u2014 tapping it adds friends to the group instantly:nn" + groupJoinLink(d.code) + "nn(Or share the code " + d.code + " for Friends → Join with code.)");n      } else alert("Could not create group"+(d&&d.error?": "+d.error:"")+".");n    }).catch(function(){alert("Server unreachable u2014 try again.");});n}nfunction joinGroupUI(){n  if(!prefs.rollNo){alert("Set your roll number first (Settings).");return;}n  var code=prompt("Enter the group code:");n  if(code===null)return;code=code.trim().toUpperCase();n  if(!code)return;n  if(myGroups.some(function(g){return g.code===code;})){alert("You're already in that group.");return;}n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"joinGroup",rollNo:prefs.rollNo,code:code}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      if(d&&d.ok){refreshGroups();}n      else alert((d&&d.error)||"Could not join group.");n    }).catch(function(){alert("Server unreachable u2014 try again.");});n}nvar activeAddGroupCode = null;nnfunction addMemberUI(code){n  activeAddGroupCode = code;n  var g = myGroups.find(function(x){return x.code===code;});n  var name = g ? g.name : "";n  n  document.getElementById("g-add-title").textContent = "Add member to group: " + name;n  document.getElementById("g-member-roll").value = "";n  document.getElementById("g-add-hint").textContent = "";n  var sugBox = document.getElementById("g-member-sug");n  if(sugBox) {n    sugBox.style.display = "none";n    sugBox.innerHTML = "";n  }n  n  var form = document.getElementById("g-add-form");n  if(form) {n    form.style.display = "block";n    form.scrollIntoView({behavior: "smooth", block: "nearest"});n  }n}nnfunction closeAddMemberUI(){n  activeAddGroupCode = null;n  var form = document.getElementById("g-add-form");n  if(form) form.style.display = "none";n}nnfunction onGroupMemberInput(){n  var v = document.getElementById("g-member-roll").value;n  renderSug("g-member-sug", v);n  var r = v.trim().toUpperCase(), hint = document.getElementById("g-add-hint");n  if(ROSTER[r]){n    hint.style.color = "var(--ok)";n    hint.textContent = "✓ " + ROSTER[r].n + " · Sec " + ROSTER[r].s;n  } else {n    hint.textContent = "";n  }n}nnfunction saveGroupMember(){n  if(!activeAddGroupCode) return;n  var roll = document.getElementById("g-member-roll").value.trim().toUpperCase();n  var hint = document.getElementById("g-add-hint");n  if(!/^B25[0-9]{3}$/.test(roll)){n    hint.style.color = "var(--bad)";n    hint.textContent = "Enter a valid roll number (B25301u2013B25480).";n    return;n  }n  n  var name = (ROSTER[roll] && ROSTER[roll].n) || roll;n  hint.style.color = "var(--t2)";n  hint.textContent = "Adding " + name + "...";n  n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"addGroupMember",rollNo:prefs.rollNo,code:activeAddGroupCode,member:roll}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      if(d&&d.ok){n        hint.style.color = "var(--ok)";n        hint.textContent = "Added successfully! ✓";n        refreshGroups();n        setTimeout(closeAddMemberUI, 1000);n      } else {n        hint.style.color = "var(--bad)";n        hint.textContent = (d && d.error) || "Could not add member.";n      }n    })n    .catch(function(){n      hint.style.color = "var(--bad)";n      hint.textContent = "Server unreachable u2014 try again.";n    });n}nfunction leaveGroupUI(code){n  if(!confirm("Leave this group?"))return;n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"leaveGroup",rollNo:prefs.rollNo,code:code}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(){refreshGroups();})n    .catch(function(){refreshGroups();});n}nfunction groupJoinLink(code){return EXEC_URL+"?join="+encodeURIComponent(code);}nfunction shareGroup(code){n  var g=myGroups.find(function(x){return x.code===code;}),name=g?g.name:"my group";n  var link=groupJoinLink(code);n  var txt="Join ""+name+"" on the Term IV Command Centre u2014 tap this link to be added instantly:n"+link;n  if(navigator.share){navigator.share({title:"Join "+name,text:txt,url:link}).catch(function(){});}n  else{try{navigator.clipboard.writeText(link);alert("Invite link copied to clipboard!nn"+txt);}catch(e){alert(txt);}}n}nnnfunction maybeAutoJoin(){n  if(!INITIAL_JOIN||!prefs.rollNo)return;n  var code=String(INITIAL_JOIN).trim().toUpperCase();n  INITIAL_JOIN=null;                                  n  if(!code)return;n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"joinGroup",rollNo:prefs.rollNo,code:code}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      if(d&&d.ok){n        refreshGroups();n        try{openF();}catch(e){}n        alert("You've joined ""+(d.name||code)+""! 🎉nnFind it under Friends → Groups.");n      } else {n        alert((d&&d.error)||("Could not join group "+code+"."));n      }n    }).catch(function(){alert("Server unreachable u2014 open Friends → Join with code: "+code);});n}nfunction openGroupPlanner(code){n  window.open(EXEC_URL+"?group="+code,"_blank");n}nn nfunction rrect(ctx,x,y,w,h,r){n  if(w<=0||h<=0)return;r=Math.min(r,w/2,h/2);n  ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.arcTo(x+w,y,x+w,y+r,r);n  ctx.lineTo(x+w,y+h-r);ctx.arcTo(x+w,y+h,x+w-r,y+h,r);n  ctx.lineTo(x+r,y+h);ctx.arcTo(x,y+h,x,y+h-r,r);n  ctx.lineTo(x,y+r);ctx.arcTo(x,y,x+r,y,r);ctx.closePath();n}nfunction generateShareCard(){n  var W=1080,H=608,canvas=document.createElement("canvas");n  canvas.width=W;canvas.height=H;n  var ctx=canvas.getContext("2d");n  var courses=prefs.courses.filter(function(c){return courseTotal(c)>0;}).slice(0,8);nn  ctx.fillStyle="#0a0a0b";ctx.fillRect(0,0,W,H);n  ctx.fillStyle="rgba(255,255,255,.025)";n  for(var px=12;px<W;px+=24)for(var py=12;py<H;py+=24){ctx.beginPath();ctx.arc(px,py,1,0,Math.PI*2);ctx.fill();}nn  var g=ctx.createLinearGradient(0,0,W*.65,0);n  g.addColorStop(0,"#d4f244");g.addColorStop(.45,"#7f77dd");g.addColorStop(1,"rgba(0,0,0,0)");n  ctx.fillStyle=g;ctx.fillRect(0,0,W,3);nn  ctx.fillStyle="#5a5754";ctx.font="500 12px monospace";n  ctx.fillText("XLRI DELHI NCR · PGDM-BM · TERM IV 2025u201327",48,52);n  ctx.fillStyle="#f4f1ec";ctx.font="bold 38px sans-serif";n  ctx.fillText(prefs.rollNo||"u2014",48,102);n  ctx.fillStyle="#5a5754";ctx.font="500 14px monospace";n  ctx.fillText("Section "+prefs.section+" · "+courses.length+" courses · "+new Date().toLocaleDateString("en-IN",{day:"numeric",month:"short",year:"numeric"}),48,130);nn  ctx.fillStyle="#18181b";ctx.fillRect(48,148,W-96,1);nn  var rowH=46,startY=162,BX=200,BW=720,BH=7;n  courses.forEach(function(code,i){n    var st=attStats(code),pct=st.total?st.present/st.total:0,color=CCOLOR[code],y=startY+i*rowH;n    ctx.beginPath();ctx.arc(58,y+rowH/2,5,0,Math.PI*2);ctx.fillStyle=color;ctx.fill();n    ctx.fillStyle=color;ctx.font="600 13px monospace";ctx.fillText(code,74,y+rowH/2+4);n    ctx.fillStyle="#222226";rrect(ctx,BX,y+rowH/2-BH/2,BW,BH,BH/2);ctx.fill();n    if(pct>0){ctx.fillStyle=color;rrect(ctx,BX,y+rowH/2-BH/2,Math.max(BH,BW*pct),BH,BH/2);ctx.fill();}n    ctx.fillStyle=pct<0.75?"#f09595":"#5a5754";ctx.font="500 12px monospace";ctx.textAlign="right";n    ctx.fillText(Math.round(pct*100)+"% · "+st.present+"/"+st.total,W-48,y+rowH/2+4);ctx.textAlign="left";n  });nn  ctx.fillStyle="#18181b";ctx.fillRect(48,H-72,W-96,1);n  ctx.fillStyle="#5a5754";ctx.font="500 11px monospace";ctx.fillText("term4 · xlri · command centre",48,H-40);n  ctx.fillStyle="#d4f244";ctx.font="600 11px monospace";ctx.textAlign="right";n  ctx.fillText("TERM IV COMMAND CENTRE",W-48,H-40);ctx.textAlign="left";nn  canvas.toBlob(function(blob){n    var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="t4-attendance-"+todayStr()+".png";a.click();n  },"image/png");n}nn nfunction nav(p,btn){n  document.querySelectorAll(".panel").forEach(function(x){x.classList.remove("on");});n  document.querySelectorAll("[data-p]").forEach(function(x){x.classList.remove("on");});n  document.getElementById("p-"+p).classList.add("on");n  document.querySelectorAll("[data-p='"+p+"']").forEach(function(x){x.classList.add("on");});n  window.scrollTo(0,0);n  if(p==="home")renderHomeAll();n  if(p==="week")renderWeek();n  if(p==="att")renderAtt();n  if(p==="leave")renderLeave();n  if(p==="prog")renderProg();n}nn nfunction buildS(){n  try {n    document.getElementById("ss-roll").value=prefs.rollNo||"";n    document.getElementById("ss-sec").innerHTML=["E","F"].map(function(s){n      return '<button class="secbtn '+((prefs.section||"")===s?"on":"")+'" data-s="'+s+'" onclick="ssSec(this)">Section '+s+'</button>';n    }).join("");n    var cs=prefs.courseSections||{},avail=Object.keys(META).sort();n    var userCourses = prefs.courses || [];n    document.getElementById("ss-cgrid").innerHTML=avail.map(function(c){n      return '<div class="ctog '+(userCourses.indexOf(c)>=0?"on":"")+'" data-ctog="'+c+'"><span class="cc">'+c+'</span><span class="cn">'+(META[c] ? META[c].name : "")+'</span>'+csecHTML(c,cs[c]||prefs.section)+'</div>';n    }).join("");n    document.querySelectorAll("#ss-cgrid .csec").forEach(function(w){if(cs[w.dataset.csec])w.dataset.pick="1";});n  } catch (e) {n    console.error("Error in buildS:", e);n  }n}nfunction ssSec(b){document.querySelectorAll("#ss-sec .secbtn").forEach(function(x){x.classList.remove("on");});b.classList.add("on");csecSyncDefaults("#ss-cgrid",b.dataset.s);}nfunction openS(){n  try { buildS(); } catch(e) { console.error("Error building settings:", e); }n  var overlay = document.getElementById("sov");n  if(overlay) overlay.classList.add("open");n}nfunction closeS(){var overlay=document.getElementById("sov");if(overlay)overlay.classList.remove("open");}nfunction openSheet(){var a=document.createElement("a");a.href=SHEET_URL;a.target="_blank";a.rel="noopener";document.body.appendChild(a);a.click();a.remove();}n nfunction openIdea(){n  try {n    var hint = document.getElementById("idea-hint");n    if(hint) hint.textContent="";n    var overlay = document.getElementById("idov");n    if(overlay) overlay.classList.add("open");n    setTimeout(function(){var t=document.getElementById("idea-text");if(t)t.focus();},60);n  } catch(e) {n    console.error("Error in openIdea:", e);n  }n}nfunction closeIdea(){var overlay=document.getElementById("idov");if(overlay)overlay.classList.remove("open");}nfunction submitIdea(){n  var txt=(document.getElementById("idea-text").value||"").trim(),hint=document.getElementById("idea-hint");n  if(!txt){hint.style.color="var(--bad)";hint.textContent="Please type your idea first.";return;}n  if(!/^[0-9]{8,15}$/.test(WA_NUMBER)){hint.style.color="var(--warn)";hint.textContent="WhatsApp number isn't set up yet u2014 ask the admin.";return;}n  var msg="Hi Jai, Is it possible to add the following feature : "+txt+". Thank You";n  var a=document.createElement("a");a.href="https://wa.me/"+WA_NUMBER+"?text="+encodeURIComponent(msg);n  a.target="_blank";a.rel="noopener";document.body.appendChild(a);a.click();a.remove();n  document.getElementById("idea-text").value="";closeIdea();n}n nfunction openMenu(){var ov=document.getElementById("menu-ov");if(ov)ov.classList.add("open");}nfunction closeMenu(){var ov=document.getElementById("menu-ov");if(ov)ov.classList.remove("open");}nn nfunction openTripPlanner() {n  closeMenu();n  var ov = document.getElementById("trip-ov");n  if(ov) ov.classList.add("open");n  switchTripTab(1);n}nfunction closeTripPlanner() {n  var ov = document.getElementById("trip-ov");n  if(ov) ov.classList.remove("open");n}nfunction switchTripTab(n) {n  document.getElementById("trip-tab-btn-1").className = "secbtn" + (n===1?" on":"");n  document.getElementById("trip-tab-btn-2").className = "secbtn" + (n===2?" on":"");n  document.getElementById("trip-tab-1").style.display = n===1?"block":"none";n  document.getElementById("trip-tab-2").style.display = n===2?"block":"none";n  if(n===1) calcTripGaps();n  if(n===2) calcCustomTrip();n}nfunction getDailyCountMap() {n  var m = {};n  var ts = todayStr();n  var tm = todayMs();n  for(var d = tm; d <= TERM_END_MS; d += 864e5) {n    var dstr = new Date(d).toISOString().split("T")[0];n    if(dstr >= ts) m[dstr] = {c:0, ex:0};n  }n  mySessions().forEach(function(s){ if(m[s.date]) m[s.date].c++; });n  (Array.isArray(EXAMS)?EXAMS:[]).forEach(function(x){n    if(m[x.date] && (!x.code || prefs.courses.indexOf(x.code)>=0)) m[x.date].ex++;n  });n  return m;n}nfunction getMissedClassesStr(sDate, eDate) {n  var ms = mySessions().filter(function(s){ return s.date >= sDate && s.date <= eDate; });n  if(!ms.length) return "Clear schedule!";n  var byCode = {};n  ms.forEach(function(s){ byCode[s.code] = (byCode[s.code]||0)+1; });n  return Object.keys(byCode).map(function(c){ return c + " (" + byCode[c] + ")"; }).join(", ");n}nfunction calcTripGaps() {n  var m = getDailyCountMap();n  var days = Object.keys(m).sort();n  var html = "";n  var stretches = [];n  for(var i=0; i<days.length-2; i++) {n    var c1 = m[days[i]], c2 = m[days[i+1]], c3 = m[days[i+2]];n    if(!c1||!c2||!c3) continue;n    if(c1.ex===0 && c2.ex===0 && c3.ex===0) {n      if(c1.c + c2.c + c3.c <= 1) {n        var end = i+2;n        while(end+1 < days.length && m[days[end+1]] && m[days[end+1]].ex === 0 && m[days[end+1]].c === 0) end++;n        stretches.push({s: days[i], e: days[end], tc: c1.c+c2.c+c3.c, len: end-i+1});n        i = end;n      }n    }n  }n  if(!stretches.length) {n    html = '<div class="free">No long gaps found for the rest of the term 🌿</div>';n  } else {n    html = stretches.map(function(st){n      var d1 = new Date(st.s+"T00:00:00+05:30"), d2 = new Date(st.e+"T00:00:00+05:30");n      var d1s = DF[d1.getDay()]+", "+d1.getDate()+" "+MO[d1.getMonth()];n      var d2s = DF[d2.getDay()]+", "+d2.getDate()+" "+MO[d2.getMonth()];n      var miss = st.tc > 0 ? ('<span style="color:var(--warn);font-weight:600">Miss '+st.tc+' class'+(st.tc>1?'es':'')+'</span> <span style="color:var(--t2)">(' + getMissedClassesStr(st.s, st.e) + ')</span>') : '<span style="color:var(--good);font-weight:600">Clear schedule! 0 classes</span>';n      return '<div style="background:var(--s1);border:.5px solid var(--b2);border-radius:var(--r);padding:12px;margin-bottom:8px">' +n        '<div style="font-family:'Syne',sans-serif;font-weight:700;margin-bottom:4px">' + st.len + ' Days</div>' +n        '<div style="font-size:13px;color:var(--t1);margin-bottom:6px">' + d1s + ' u2014 ' + d2s + '</div>' +n        '<div style="font-size:11px">' + miss + '</div>' +n      '</div>';n    }).join("");n  }n  var el = document.getElementById("trip-gaps-list");n  if(el) el.innerHTML = html;n}nfunction calcCustomTrip() {n  var dur = parseInt(document.getElementById("trip-dur").value)||3;n  var maxM = parseInt(document.getElementById("trip-max-miss").value)||0;n  if(dur<1) dur=1; if(maxM<0) maxM=0;n  var m = getDailyCountMap();n  var days = Object.keys(m).sort();n  var html = "";n  var valid = [];n  for(var i=0; i<=days.length-dur; i++) {n    var tc = 0, tex = 0, missingData = false;n    for(var j=0; j<dur; j++){n      if(!m[days[i+j]]) { missingData = true; break; }n      tc += m[days[i+j]].c;n      tex += m[days[i+j]].ex;n    }n    if(!missingData && tex === 0 && tc <= maxM) {n      valid.push({s: days[i], e: days[i+dur-1], tc: tc});n    }n  }n  if(!valid.length) {n    html = '<div class="free">No '+dur+'-day trips missing &le; '+maxM+' classes 🌿</div>';n  } else {n    html = valid.map(function(st){n      var d1 = new Date(st.s+"T00:00:00+05:30"), d2 = new Date(st.e+"T00:00:00+05:30");n      var d1s = DF[d1.getDay()]+", "+d1.getDate()+" "+MO[d1.getMonth()];n      var d2s = (dur===1) ? "" : " u2014 " + DF[d2.getDay()]+", "+d2.getDate()+" "+MO[d2.getMonth()];n      var miss = st.tc > 0 ? ('<span style="color:var(--warn);font-weight:600">Miss '+st.tc+' class'+(st.tc>1?'es':'')+'</span> <span style="color:var(--t2)">(' + getMissedClassesStr(st.s, st.e) + ')</span>') : '<span style="color:var(--good);font-weight:600">Clear schedule! 0 classes</span>';n      return '<div style="background:var(--s1);border:.5px solid var(--b2);border-radius:var(--r);padding:12px;margin-bottom:8px">' +n        '<div style="font-size:13px;font-weight:600;margin-bottom:4px">' + d1s + d2s + '</div>' +n        '<div style="font-size:11px">' + miss + '</div>' +n      '</div>';n    }).join("");n  }n  var el = document.getElementById("trip-custom-list");n  if(el) el.innerHTML = html;n}nnfunction applyS(){n  var sec=document.querySelector("#ss-sec .secbtn.on");if(!sec)return;n  var cs=document.querySelectorAll("#ss-cgrid .ctog.on"),courses=[];n  cs.forEach(function(el){courses.push(el.dataset.ctog);});n  if(!courses.length)return;n  n  var nr=document.getElementById("ss-roll").value.trim().toUpperCase();n  var validRoll = /^B25