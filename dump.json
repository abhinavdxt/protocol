s=ANN_DATA.filter(function(a){return dismissed.indexOf(a.id)<0;});n  if(!vis.length){el.innerHTML="";return;}n  el.innerHTML='<div class="ann-scroll">'+vis.map(function(a){n    return '<div class="ann-card '+(a.type||"info")+'"><span class="ann-dot"></span><div><div class="ann-text">'+a.text+'</div><div class="ann-date">'+a.date+'</div></div><button class="ann-x" data-ann="'+a.id+'">✕</button></div>';n  }).join("")+'</div>';n}nfunction dismissAnn(id){dismissed.push(id);saveDismissed();renderAnnouncements();}nn nfunction renderWeekHeat(){n  var el=document.getElementById("week-heat");if(!el)return;n  var today=todayMs(),mon=new Date(today);n  mon.setDate(mon.getDate()-((mon.getDay()+6)%7));n  var dns=["M","T","W","T","F","S","S"],days="";n  for(var i=0;i<7;i++){n    var d=new Date(mon);d.setDate(mon.getDate()+i);n    var ds=dstr(d),cnt=byDate(ds).length,isT=ds===todayStr();n    var cls=cnt===0?"":cnt===1?"d1":cnt<=2?"d2":cnt<=3?"d3":"d4";n    days+='<div class="wh-day'+(isT?" wh-today":"")+'"><div class="wh-dot '+cls+'"></div><div class="wh-dn">'+dns[i]+'</div></div>';n  }n  el.innerHTML='<span class="wh-label">This week</span><div class="wh-days">'+days+'</div>';n}nn nfunction renderTodayStrip(){n  var el=document.getElementById("today-strip");if(!el)return;n  var ss=byDate(todayStr());n  if(!ss.length){el.style.display="none";return;}n  el.style.display="";n  var DS2=480,DE=1320,SP=DE-DS2;n  var now=new Date(),nm=now.getHours()*60+now.getMinutes();n  var blocks=ss.map(function(s){n    var sm=s.sh*60+s.sm,l=Math.max(0,(sm-DS2)/SP*100),w=90/SP*100;n    return '<div class="t-sess" style="left:'+l.toFixed(1)+'%;width:'+w.toFixed(1)+'%;background:'+CCOLOR[s.code]+'">'+s.code+'</div>';n  }).join("");n  var nowHtml=(nm>=DS2&&nm<=DE)?'<div class="t-now" style="left:'+((nm-DS2)/SP*100).toFixed(1)+'%"></div>':"";n  el.innerHTML='<div class="t-head"><span>Today timeline</span><span>8 am &#8594; 10 pm</span></div>'n    +'<div class="t-track">'+blocks+nowHtml+'</div>'n    +'<di