Div.style.display="block";n  var lnk=document.getElementById("vm-setup-link");if(lnk)lnk.href=EXEC_URL;n  var cta=document.getElementById("vm-cta-link");if(cta)cta.href=EXEC_URL;n  fetch(EXEC_URL,{method:"POST",body:JSON.stringify({action:"getPrefs",rollNo:roll}),redirect:"follow"})n    .then(function(r){return r.json();})n    .then(function(d){n      if(d&&d.ok&&d.data&&d.data.section&&d.data.courses&&d.data.courses.length){n        prefs={rollNo:roll,section:d.data.section,courses:d.data.courses,courseSections:d.data.courseSections||{},groups:[]};n        loadAll();n        renderViewMode();n      } else {n        document.getElementById("vm-loading").style.display="none";n        var err=document.getElementById("vm-error");n        if(err){err.style.display="block";err.textContent=roll+" hasn't set up their timetable yet. Tap 'Set up yours →' above.";}n      }n    })n    .catch(function(){n      document.getElementById("vm-loading").style.display="none";n      var err=document.getElementById("vm-error");n      if(err){err.style.display="block";err.textContent="Could not load timetable u2014 check your connection and refresh.";}n    });n}nfunction renderViewMode(){n  document.getElementById("vm-loading").style.display="none";n  document.getElementById("vm-content").style.display="block";n  var name=(ROSTER[prefs.rollNo]&&ROSTER[prefs.rollNo].n)||prefs.rollNo;n  var nameEl=document.getElementById("vm-name");if(nameEl)nameEl.textContent=name;n  var badgeEl=document.getElementById("vm-badge");if(badgeEl)badgeEl.textContent="Sec "+prefs.section;n  try{document.title=name+"'s Timetable · Term IV";}catch(e){}n  n  var now=Date.now(),my=mySessions();n  var up=my.filter(function(s){return sessionMs(s)+90*6e4>now;}).sort(function(a,b){return sessionMs(a)-sessionMs(b);});n  var nb=document.getElementById("vm-next-banner");n  if(nb&&up.length){n    var n=up[0],nd=new Date(n.date+"T00:00:00+05:30"),ts=todayStr(),tm=todayMs();n    var isOngoing=now>=sessionMs(n)&&now<=sessionMs(n)+90*6e4;n    var when=n.date===ts?"today":(nd.getTime()===tm+864e5?"tomorrow":DS[nd.getDay()]+" "+nd.getDate()+" "+MO[nd.getMonth()]);n    var label=isOngoing?'<span class="pulse-live"></span>Ongoing now':'Next up';n    nb.innerHTML='<div class="nbanner" style="--cc:'+CCOLOR[n.code]+';margin-bottom:14px"><span class="nb-dot"></span><div><div class="nb-l">'+label+'</div><div class="nb-c">'+META[n.code].name+'</div><div class="nb-t">S'+n.n+' · '+n.slot+' · '+when+'</div></div><div class="nb-p">S'+n.n+'/'+courseTotal(n.code)+'</div></div>';n  } else if(nb){nb.innerHTML="";}n  n  var today=todayMs();n  document.getElementById("vm-today").innerHTML=renderDay(today,"Today",false);n  document.getElementById("vm-tomorrow").innerHTML=renderDay(today+864e5,"Tomorrow",false);n  n  var exEl=document.getElementById("vm-exams");n  if(exEl&&Array.isArray(EXAMS)&&EXAMS.length){n    var ts2=todayStr(),tm2=todayMs();n    var upExams=EXAMS.filter(function(x){return x.date>=ts2;}).slice(0,4).map(function(x){n      var d=new Date(x.date+"T00:00:00+05:30"),days=Math.round((d.getTime()-tm2)/864e5);n      var badge=x.type==="Quiz"?"quiz":x.type==="Mid-Term"?"mid":"end";n      var when=DF[d.getDay()]+", "+d.getDate()+" "+MO[d.getMonth()]+" · "+x.slot;n      var cd=days<=0?"Today":days===1?"1 day":days+" days";n      return '<div class="exam-row"><span class="exam-badge '+badge+'">'+x.type+'</span>'n        +'<div class="exam-body"><div class="exam-text">'+x.text+'</div><div class="exam-when">'+when+'</div></div>'n        +'<div class="exam-cd'+(days<=1?" imminent":days<=3?" soon":"")+'"><b>'+cd+'</b></div></div>';n    }).join("");n    if(upExams)exEl.innerHTML='<div class="exam-wrap" style="margin-top:0"><div class="exam-head"><span class="exam-title">📌 Upcoming Assessments</span></div>'+upExams+'</div>';n    else exEl.innerHTML="";n  } else if(exEl){exEl.innerHTML="";}n  renderViewWeek();n}nfunction renderViewWeek(){n  var base=new Date(todayMs()),mon=new Date(base);n  mon.setDate(base.getDate()-((base.getDay()+6)%7)+vmWkOff*7);n  var days=[];for(var i=0;i<7;i++){var d2=new Date(mon);d2.setDate(mon.getDate()+i);days.push(d2);}n  var wkl=document.getElementById("vm-wkl");if(wkl)wkl.textContent=mon.getDate()+" "+MO[mon.getMonth()]+" u2013 "+days[6].getDate()+" "+MO[days[6].getMonth()];n  var pw=document.getElementById("vm-pw");if(pw)pw.disabled=vmWkOff<=-2;n  var nw=document.getElementById("vm-nw");if(nw)nw.disabled=vmWkOff>=12;n  var grid=document.getElementById("vm-wkgrid");if(!grid)return;n  grid.innerHTML=days.map(function(d2){n    var ds=dstr(d2),isT=ds===todayStr(),ss=byDate(ds),heavy=ss.length>=3;n    var chips=ss.map(function(s){return '<span class="wchip" style="color:'+CCOLOR[s.code]+'">'+s.code+'<span class="wct">'+s.slot+'</span></span>';}).join("");n    return '<div class="wd'+(isT?" today":"")+(heavy?" heavy":"")+'"><div class="wd-top"><div class="wd-d">'+DS[d2.getDay()]+'</div><div class="wd-n">'+d2.getDate()+'</div></div><div class="wd-chips">'+(chips||'<span class="wd-empty">u2014</span>')+'</div></div>';n  }).join("");n}nfunction shiftVmWk(d){vmWkOff+=d;renderViewWeek();}nfunction switchVmTab(tab,btn){n  document.querySelectorAll("[data-vmtab]").forEach(function(b){b.classList.remove("on");});n  if(btn)btn.classList.add("on");n  document.getElementById("vm-today-pane").style.display=tab==="week"?"none":"block";n  document.getElementById("vm-week-pane").style.display=tab==="week"?"block":"none";n}nnnvar scrollObs = new MutationObserver(function() {n  var anyOpen = document.querySelector('.ovl-bg.open');n  if(anyOpen) document.body.classList.add('no-scroll');n  else document.body.classList.remove('no-scroll');n});ndocument.querySelectorAll('.ovl-bg').forEach(function(el){n  scrollObs.observe(el, {attributes:true, attributeFilter:['class']});n});nnif(INITIAL_VIEW){n  loadViewMode(INITIAL_VIEW);n} else {n  buildOb();n  if(load()){loadAll();launch();}n  else if(INITIAL_ROLL){autoRestoreByRoll(INITIAL_ROLL);}n  else{var ckRoll=readCooki